---
import type { SiteMeta } from "@/types";
import BaseHead from "@/components/layout/BaseHead.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import SkipLink from "@/components/ui/SkipLink.astro";
import { siteInfo } from "@/siteInfo";
import { DEFAULT_PALETTE, palettes, getPaletteScheme } from "@/data/palettes";
interface Props {
	meta: SiteMeta;
	home?: boolean;
}
const {
	meta: {
		title = siteInfo.title,
		description = siteInfo.description,
		articleDate,
		author,
		hasMarkdownAlternate,
		robots,
		jsonLd,
	},
	home = false,
} = Astro.props;
const defaultPalette = palettes.find((palette) => palette.id === DEFAULT_PALETTE) ?? palettes[0]!;
---

<html
	lang={siteInfo.lang}
	class={getPaletteScheme(defaultPalette) === "dark" ? "dark" : undefined}
	data-palette={DEFAULT_PALETTE}
	data-ground={String(defaultPalette.initialGround ?? 0)}
>
	<head>
		<BaseHead
			title={title}
			description={description}
			articleDate={articleDate}
			author={author}
			hasMarkdownAlternate={hasMarkdownAlternate}
			robots={robots}
			jsonLd={jsonLd}
			chromeColor={home ? "#235C43" : undefined}
		/>
	</head>
	<body class:list={["signals-shell", { "home-page": home }]}>
		<SkipLink />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script src="../scripts/signal.ts"></script>
	</body>
</html>

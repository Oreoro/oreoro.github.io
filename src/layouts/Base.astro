---
import type { SiteMeta } from "@/types";
import BaseHead from "@/components/layout/BaseHead.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import SkipLink from "@/components/ui/SkipLink.astro";
import { siteInfo } from "@/siteInfo";
import { DEFAULT_PALETTE } from "@/data/palettes";
interface Props {
	meta: SiteMeta;
	/** Fixed entry ground for legacy palette previews; the default rotates. */
	themeIndex?: number;
	/** The "next signal" dot shown bottom-right on small screens. */
	footerNext?: { href: string; label: string };
}
const {
	meta: {
		title = siteInfo.title,
		description = siteInfo.description,
		articleDate,
		author,
		hasMarkdownAlternate,
		robots,
		jsonLd,
	},
	themeIndex,
	footerNext,
} = Astro.props;
---

<html
	lang={siteInfo.lang}
	class="dark"
	data-palette={DEFAULT_PALETTE}
	data-theme-index={themeIndex === undefined ? undefined : String(themeIndex)}
>
	<head>
		<BaseHead
			title={title}
			description={description}
			articleDate={articleDate}
			author={author}
			hasMarkdownAlternate={hasMarkdownAlternate}
			robots={robots}
			jsonLd={jsonLd}
		/>
	</head>
	<body class="signals-shell">
		<SkipLink />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer next={footerNext} />
		<script src="../scripts/signal.ts"></script>
	</body>
</html>

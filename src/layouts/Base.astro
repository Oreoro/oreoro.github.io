---
import type { SiteMeta } from "@/types";
import BaseHead from "@/components/layout/BaseHead.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import SkipLink from "@/components/ui/SkipLink.astro";
import { siteInfo } from "@/siteInfo";
interface Props {
	meta: SiteMeta;
}
const {
	meta: {
		title = siteInfo.title,
		description = siteInfo.description,
		articleDate,
		author,
		hasMarkdownAlternate,
		jsonLd,
	},
} = Astro.props;
---

<html lang={siteInfo.lang} class="dark">
	<head>
		<BaseHead
			title={title}
			description={description}
			articleDate={articleDate}
			author={author}
			hasMarkdownAlternate={hasMarkdownAlternate}
			jsonLd={jsonLd}
		/>
	</head>
	<body class="signals-shell">
		<SkipLink />
		<Header />
		<main id="main">
			<slot />
		</main>
		<Footer />
		<script src="../scripts/signal.ts"></script>
	</body>
</html>

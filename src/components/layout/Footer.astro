---
import { getNavLink } from "@/lib/blog-helpers";

interface Props {
	next?: { href: string; label: string } | undefined;
}

const { next } = Astro.props;

const links: Array<[string, string]> = [
	["Studio", "/studio"],
	["Stack", "/stack"],
	["Thoughts", "/thoughts"],
	["Podcast", "/podcast"],
	["Books", "/books"],
	["Jobs", "/jobs"],
	["Policies", "/policies"],
	["Contact", "/contact"],
	["LinkedIn", "https://www.linkedin.com/company/110646093/"],
];

const isExternal = (href: string) => href.startsWith("http");
const link = (href: string) => (isExternal(href) ? href : getNavLink(href));
---

<footer class="footer">
	<ul>
		{
			links.map(([label, href]) => (
				<li>
					<a
						href={link(href)}
						aria-label={label}
						target={isExternal(href) ? "_blank" : undefined}
						rel={isExternal(href) ? "noopener" : undefined}
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
	{
		next && (
			<div class="footer__next">
				<a href={getNavLink(next.href)} aria-label={`Next signal: ${next.label}`} tabindex="-1" />
			</div>
		)
	}
</footer>

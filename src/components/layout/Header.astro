---
import { getNavLink } from "@/lib/blog-helpers";
import Brand from "@/components/layout/Brand.astro";

const primary: Array<[string, string]> = [
	["Focus Lab", "/"],
	["Urbanevents", "/products/urbanevents"],
	["Workproof", "/products/workproof"],
	["Muxo", "/products/muxo"],
];

const secondary: Array<[string, string]> = [
	["Studio", "/studio"],
	["Stack", "/stack"],
	["Thoughts", "/thoughts"],
	["Podcast", "/podcast"],
	["Books", "/books"],
	["Jobs", "/jobs"],
	["Policies", "/policies"],
	["Contact", "/contact"],
];

const isExternal = (href: string) => href.startsWith("http");
const link = (href: string) => (isExternal(href) ? href : getNavLink(href));
---

<input class="nav-active" id="nav-active" type="checkbox" />

<label class="nav-underlay" for="nav-active"></label>

<nav class="nav" aria-label="Mobile navigation">
	<div class="nav__logo">
		<Brand />
	</div>
	<div class="nav__toggle">
		<label for="nav-active">
			<span>Menu</span>
		</label>
	</div>
	<div class="nav__options">
		<ul>
			{
				primary.map(([label, href]) => (
					<li>
						<a
							href={link(href)}
							aria-label={label}
							target={isExternal(href) ? "_blank" : undefined}
							rel={isExternal(href) ? "noopener" : undefined}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<ul>
			{
				secondary.map(([label, href]) => (
					<li>
						<a
							href={link(href)}
							aria-label={label}
							target={isExternal(href) ? "_blank" : undefined}
							rel={isExternal(href) ? "noopener" : undefined}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>

<header class="header">
	<div class="header__brand">
		<Brand />
	</div>
	<ul>
		{
			primary.map(([label, href]) => (
				<li>
					<a
						href={link(href)}
						aria-label={label}
						target={isExternal(href) ? "_blank" : undefined}
						rel={isExternal(href) ? "noopener" : undefined}
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
</header>

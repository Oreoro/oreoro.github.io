---
import { getNavLink } from "@/lib/blog-helpers";
import Brand from "@/components/layout/Brand.astro";

const primary: Array<[string, string]> = [
	["Products", "/products"],
	["Studio", "/studio"],
	["Thoughts", "/thoughts"],
	["Contact", "/contact"],
];

const secondary: Array<[string, string]> = [
	["Stream", "/stream"],
	["Stack", "/stack"],
	["Podcast", "/podcast"],
	["Books", "/books"],
	["Jobs", "/jobs"],
	["Policies", "/policies"],
];

const isCurrent = (href: string) => {
	const path = Astro.url.pathname.replace(/\/$/, "");
	const destination = getNavLink(href).replace(/\/$/, "");
	return (
		path === destination ||
		path.startsWith(`${destination}/`) ||
		(href === "/stream" && /\/\d+$/.test(path))
	);
};
---

<header class="site-header">
	<div class="header">
		<div class="header__brand"><Brand /></div>
		<nav class="header__links" aria-label="Primary navigation">
			<ul>
				{
					primary.map(([label, href]) => (
						<li>
							<a href={getNavLink(href)} aria-current={isCurrent(href) ? "page" : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<nav class="nav" aria-label="Mobile navigation">
			<input
				class="nav-active"
				id="nav-active"
				type="checkbox"
				aria-label="Menu"
				aria-controls="nav-options"
			/>
			<div class="nav__toggle">
				<label for="nav-active">
					<span class="nav__toggle-text">Menu</span>
					<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
						<path
							class="nav__open-icon"
							d="M3 6h12M3 12h12"
							stroke="currentColor"
							stroke-width="1.5"></path>
						<path
							class="nav__close-icon"
							d="m4 4 10 10M14 4 4 14"
							stroke="currentColor"
							stroke-width="1.5"></path>
					</svg>
				</label>
			</div>
			<div class="nav__options" id="nav-options">
				{
					[primary, secondary].map((links) => (
						<ul>
							{links.map(([label, href]) => (
								<li>
									<a href={getNavLink(href)} aria-current={isCurrent(href) ? "page" : undefined}>
										{label}
									</a>
								</li>
							))}
						</ul>
					))
				}
			</div>
		</nav>
	</div>
</header>
<div class="nav-underlay" aria-hidden="true"></div>

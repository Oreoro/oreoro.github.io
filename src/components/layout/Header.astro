---
import { getNavLink } from "@/lib/blog-helpers";
import Brand from "@/components/layout/Brand.astro";

const primary: Array<[string, string]> = [
	["Stream", "/"],
	["Urban Events", "/products/urbanevents"],
	["WorkProof", "/products/workproof"],
	["Fixer", "/products/fixer"],
];

const secondary: Array<[string, string]> = [
	["Products", "/products"],
	["Studio", "/studio"],
	["Stack", "/stack"],
	["Thoughts", "/thoughts"],
	["Podcast", "/podcast"],
	["Books", "/books"],
	["Jobs", "/jobs"],
	["Policies", "/policies"],
	["Contact", "/contact"],
];

const isExternal = (href: string) => href.startsWith("http");
const link = (href: string) => (isExternal(href) ? href : getNavLink(href));
const isCurrent = (href: string) =>
	Astro.url.pathname.replace(/\/$/, "") === link(href).replace(/\/$/, "");
---

<nav class="nav" aria-label="Mobile navigation">
	<input
		class="nav-active"
		id="nav-active"
		type="checkbox"
		aria-label="Menu"
		aria-expanded="false"
		aria-controls="nav-options"
	/>

	<div class="nav__logo">
		<Brand />
	</div>
	<div class="nav__toggle">
		<label for="nav-active">
			<span>Menu</span>
		</label>
	</div>
	<div class="nav__options" id="nav-options">
		<ul>
			{
				primary.map(([label, href]) => (
					<li>
						<a
							href={link(href)}
							aria-label={label}
							aria-current={isCurrent(href) ? "page" : undefined}
							target={isExternal(href) ? "_blank" : undefined}
							rel={isExternal(href) ? "noopener" : undefined}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<ul>
			{
				secondary.map(([label, href]) => (
					<li>
						<a
							href={link(href)}
							aria-label={label}
							aria-current={isCurrent(href) ? "page" : undefined}
							target={isExternal(href) ? "_blank" : undefined}
							rel={isExternal(href) ? "noopener" : undefined}
						>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>

<label class="nav-underlay" for="nav-active" aria-hidden="true"></label>

<header class="header">
	<div class="header__brand">
		<Brand />
	</div>
	<ul>
		{
			primary.map(([label, href]) => (
				<li>
					<a
						href={link(href)}
						aria-label={label}
						aria-current={isCurrent(href) ? "page" : undefined}
						target={isExternal(href) ? "_blank" : undefined}
						rel={isExternal(href) ? "noopener" : undefined}
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
</header>

---
import { getNavLink } from "@/lib/blog-helpers";
import Brand from "@/components/layout/Brand.astro";
import { products } from "@/data/products";

const primary: Array<[string, string]> = [
	["Stream", "/"],
	...products.map((product): [string, string] => [product.name, `/products/${product.slug}/`]),
];

/* The mobile sheet is grouped so a long list reads as a menu, not a wall. */
const mobileGroups: Array<[string, Array<[string, string]>]> = [
	[
		"The stream",
		[["Stream", "/"]],
	],
	[
		"Products",
		[
			["Products", "/products"],
			...products.map((product): [string, string] => [product.name, `/products/${product.slug}/`]),
		],
	],
	[
		"Studio",
		[
			["Studio", "/studio"],
			["Stack", "/stack"],
			["Thoughts", "/thoughts"],
			["Podcast", "/podcast"],
			["Books", "/books"],
		],
	],
	[
		"Company",
		[
			["Jobs", "/jobs"],
			["Policies", "/policies"],
			["RSS", "/rss.xml"],
			["Contact", "/contact"],
		],
	],
];

const isExternal = (href: string) => href.startsWith("http");
const link = (href: string) => (isExternal(href) ? href : getNavLink(href));
const isCurrent = (href: string) => {
	if (isExternal(href)) return false;
	const path = Astro.url.pathname.replace(/\/$/, "");
	const destination = link(href).replace(/\/$/, "");
	return (
		path === destination ||
		(destination !== "" && path.startsWith(`${destination}/`)) ||
		(href === "/" && /\/\d+$/.test(path))
	);
};
---

<nav class="nav" aria-label="Mobile navigation">
	<input
		class="nav-active"
		id="nav-active"
		type="checkbox"
		aria-label="Open menu"
		aria-controls="nav-options"
	/>

	<div class="nav__logo">
		<Brand />
	</div>
	<div class="nav__toggle">
		<label for="nav-active">
			<span class="nav__toggle-text" aria-hidden="true"></span>
		</label>
	</div>
	<div class="nav__options" id="nav-options">
		{
			mobileGroups.map(([groupLabel, items]) => (
				<div class="nav__group">
					<p class="nav__group-label">{groupLabel}</p>
					<ul>
						{
							items.map(([label, href]) => (
								<li>
									<a
										href={link(href)}
										aria-label={label}
										aria-current={isCurrent(href) ? "page" : undefined}
										target={isExternal(href) ? "_blank" : undefined}
										rel={isExternal(href) ? "noopener" : undefined}
									>
										{label}
									</a>
								</li>
							))
						}
					</ul>
				</div>
			))
		}
	</div>
</nav>

<div class="nav-underlay" aria-hidden="true"></div>

<header class="header">
	<div class="header__brand">
		<Brand />
	</div>
	<ul>
		{
			primary.map(([label, href]) => (
				<li>
					<a
						href={link(href)}
						aria-label={label}
						aria-current={isCurrent(href) ? "page" : undefined}
						target={isExternal(href) ? "_blank" : undefined}
						rel={isExternal(href) ? "noopener" : undefined}
					>
						{label}
					</a>
				</li>
			))
		}
	</ul>
</header>
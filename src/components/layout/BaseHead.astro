---
import type { SiteMeta } from "@/types";
import "@/styles/refined-shell.css";
import "@/styles/notion-signals.css";
import { siteInfo } from "@/siteInfo";
import { site } from "@/data/focuslab";
import { palettes, DEFAULT_PALETTE, getPaletteScheme } from "@/data/palettes";
import { ENABLE_LIGHTBOX, TRACKING, GOOGLE_SEARCH_CONSOLE_META_TAG, GISCUS } from "@/constants";
import { getNavLink } from "@/lib/blog-helpers";

type Props = SiteMeta & { chromeColor?: string | undefined };

const {
	title,
	description,
	articleDate,
	author,
	hasMarkdownAlternate,
	jsonLd,
	robots,
	chromeColor,
} = Astro.props;

const titleSeparator = "•";
const siteTitle =
	title && title !== siteInfo.title
		? `${title} ${titleSeparator} ${siteInfo.title}`
		: siteInfo.title;
const metaDescription = description || siteInfo.description;
const metaRobots = robots || "index, follow, max-image-preview:large";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const markdownAlternateUrl = new URL("./index.html.md", Astro.url).href;
const faviconLink = getNavLink("/favicon.ico");

const siteUrl = import.meta.env.SITE?.toString().replace(/\/$/, "") ?? canonicalURL.origin;
const organizationId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;

/**
 * Where this page sits in the site, as a breadcrumb trail: the path segments
 * between the apex and this page, so /policies/privacy/ reads
 * Home › Policies › Privacy Policy.
 */
const breadcrumbTrail = (() => {
	const segments = Astro.url.pathname.split("/").filter(Boolean);
	if (segments.length === 0) return [];

	const nodes = [{ name: "Home", path: "/" }];
	segments.forEach((segment, i) => {
		nodes.push({
			name: segment.replace(/-/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()),
			path: `/${segments.slice(0, i + 1).join("/")}/`,
		});
	});

	// Label the leaf with the real page title rather than a prettified slug.
	const leaf = nodes[nodes.length - 1];
	if (leaf) leaf.name = title || siteInfo.title;

	return nodes;
})();

const structuredData = [
	{
		"@context": "https://schema.org",
		"@type": "Organization",
		"@id": organizationId,
		name: siteInfo.title,
		url: siteUrl,
		description: siteInfo.description,
		logo: {
			"@type": "ImageObject",
			url: new URL(getNavLink("/icon-512.png"), siteUrl).href,
			width: 512,
			height: 512,
		},
		email: site.email,
		telephone: site.phone,
		address: {
			"@type": "PostalAddress",
			addressLocality: "Islamabad",
			addressCountry: "PK",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		"@id": websiteId,
		name: siteInfo.title,
		url: siteUrl,
		description: siteInfo.description,
		inLanguage: siteInfo.lang,
		publisher: { "@id": organizationId },
	},
	// The page itself. Without this, every page in the site describes itself as
	// nothing but the generic WebSite above.
	...(Astro.url.pathname === "/" || /\bnoindex\b/i.test(metaRobots)
		? []
		: [
				{
					"@context": "https://schema.org",
					"@type": "WebPage",
					"@id": `${canonicalURL.href}#webpage`,
					url: canonicalURL.href,
					name: siteTitle,
					description: metaDescription,
					inLanguage: siteInfo.lang,
					isPartOf: { "@id": websiteId },
					about: { "@id": organizationId },
					...(breadcrumbTrail.length > 1
						? { breadcrumb: { "@id": `${canonicalURL.href}#breadcrumb` } }
						: {}),
				},
				...(breadcrumbTrail.length > 1
					? [
							{
								"@context": "https://schema.org",
								"@type": "BreadcrumbList",
								"@id": `${canonicalURL.href}#breadcrumb`,
								itemListElement: breadcrumbTrail.map((crumb, i) => ({
									"@type": "ListItem",
									position: i + 1,
									name: crumb.name,
									item: new URL(crumb.path, siteUrl).href,
								})),
							},
						]
					: []),
			]),
	...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
const isBuildOrPreviewMode = import.meta.env.MODE === "production";
// Use provided author or fallback to site author
const metaAuthor = author || siteInfo.author;
const publicGaTrackingId =
	isBuildOrPreviewMode &&
	TRACKING &&
	Object.keys(TRACKING).length > 0 &&
	TRACKING["google-analytics"] &&
	Object.keys(TRACKING["google-analytics"]).length > 0 &&
	TRACKING["google-analytics"]["use-ga"] &&
	TRACKING["google-analytics"]["public-ga-tracking-id"]
		? TRACKING["google-analytics"]["public-ga-tracking-id"]
		: null;
const setUmami =
	isBuildOrPreviewMode &&
	TRACKING &&
	Object.keys(TRACKING).length > 0 &&
	TRACKING["umami"] &&
	Object.keys(TRACKING["umami"]).length > 0 &&
	TRACKING["umami"]["use-umami"] &&
	TRACKING["umami"]["data-website-id"];
const umamiDataWebsiteId = setUmami ? TRACKING["umami"]["data-website-id"] : null;
const umamiSrc = isBuildOrPreviewMode
	? setUmami && TRACKING["umami"]["self-hosted"] && TRACKING["umami"]["self-hosted-umami-url"]
		? TRACKING["umami"]["self-hosted-umami-url"]
		: "https://cloud.umami.is/script.js"
	: null;

const useGiscus =
	GISCUS &&
	Object.keys(GISCUS).length > 0 &&
	GISCUS["data-repo"] &&
	GISCUS["data-repo-id"] &&
	GISCUS["data-category"] &&
	GISCUS["data-category-id"];

/* Stable browser chrome, including when JavaScript is unavailable. */
const defaultPalette = palettes.find((palette) => palette.id === DEFAULT_PALETTE) ?? palettes[0]!;
const themeColor = chromeColor ?? defaultPalette.themeColor;

/*
 * Social card. Currently the square brand mark, so `summary` rather than
 * `summary_large_image` — declaring a large card over a 512 square image is how
 * you get a thumbnail letterboxed inside a wide grey box.
 */
const socialCardType = "summary";
const socialImageWidth = "512";
const socialImageHeight = "512";
const socialImage = new URL(getNavLink("/icon-512.png"), siteUrl).href;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no" />

{/* Preconnect to giscus for faster loading */}
{useGiscus && <link rel="preconnect" href="https://giscus.app" crossorigin />}

{/* Preload the shell font */}
<link
	rel="preload"
	href="/assets/fonts/LabGrotesque-Regular.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>
<link
	rel="preload"
	href="/assets/fonts/LabGrotesque-Bold.woff2"
	as="font"
	type="font/woff2"
	crossorigin
/>

{
	ENABLE_LIGHTBOX && (
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css"
			media="print"
			onload="this.media='all'"
		/>
	)
}
<meta http-equiv="X-UA-Compatible" content="IE=edge" />
<title>{siteTitle}</title>

{/* Icons / Favicon */}
<link rel="icon" href={getNavLink("/favicon.svg")} type="image/svg+xml" />
<link rel="icon" href={faviconLink} sizes="any" />
<link rel="apple-touch-icon" href={getNavLink("/apple-touch-icon.png")} />
<link rel="manifest" href={getNavLink("/site.webmanifest")} />
<link rel="canonical" href={canonicalURL} />
{hasMarkdownAlternate && <link rel="alternate" type="text/markdown" href={markdownAlternateUrl} />}

{/* Primary Meta Tags */}
<meta name="title" content={siteTitle} />
<meta name="description" content={metaDescription} />
<meta name="author" content={metaAuthor} />
<meta name="robots" content={metaRobots} />
<meta name="application-name" content={siteInfo.title} />
<meta name="apple-mobile-web-app-title" content={siteInfo.title} />

{/* Theme Colour */}
<meta name="color-scheme" content={getPaletteScheme(defaultPalette)} />
<meta name="theme-color" content={themeColor} />

{
	/*
	Social metadata. The Open Graph *text* tags are back; 061cb14 removed the
	whole set along with og.png. A 1200x630 card would need a real text-bearing
	image, and the site's only typeface is woff2 — which neither satori nor
	resvg can rasterise — so rather than point at a file that does not exist,
	this uses the 512 brand mark with a `summary` card, which is a valid and
	honest representation. Swap in a 1200x630 card and change the two constants
	below to switch to a large image.
*/
}
<meta property="og:type" content={articleDate ? "article" : "website"} />
<meta property="og:title" content={siteTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:site_name" content={siteInfo.title} />
<meta property="og:locale" content={siteInfo.ogLocale} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={socialImageWidth} />
<meta property="og:image:height" content={socialImageHeight} />
<meta property="og:image:alt" content={`${siteInfo.title} — ${siteInfo.description}`} />
<meta name="twitter:card" content={socialCardType} />
<meta name="twitter:title" content={siteTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={socialImage} />

{
	articleDate && (
		<>
			<meta property="article:author" content={metaAuthor} />
			<meta property="article:published_time" content={articleDate} />
		</>
	)
}

{
	GOOGLE_SEARCH_CONSOLE_META_TAG && (
		<meta name="google-site-verification" content={GOOGLE_SEARCH_CONSOLE_META_TAG} />
	)
}

{/* Structured data */}
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

{/* Sitemap */}
<link rel="sitemap" href="/sitemap.xml" />

{/* RSS auto-discovery */}
<link
	rel="alternate"
	type="application/rss+xml"
	title={siteInfo.title}
	href={getNavLink("/rss.xml")}
/>

{/* Webmentions */}
{
	siteInfo.webmentions && siteInfo.webmentions.link && (
		<>
			<link rel="webmention" href={siteInfo.webmentions.link} />
			{siteInfo.webmentions.pingback && (
				<link rel="pingback" href={siteInfo.webmentions.pingback} />
			)}
		</>
	)
}
{
	publicGaTrackingId && (
		<>
			<script
				type="text/partytown"
				src={`https://www.googletagmanager.com/gtag/js?id=${publicGaTrackingId}`}
				defer
			/>
			<script
				is:inline
				type="text/partytown"
				define:vars={{ publicGaTrackingId }}
				defer
				set:html={`
					window.dataLayer = window.dataLayer || [];
					function gtag() {
						dataLayer.push(arguments);
					}
					gtag("js", new Date());
					gtag("config", publicGaTrackingId);
				`}
			/>
		</>
	)
}
{
	setUmami && (
		<script
			type="text/partytown"
			data-astro-rerun
			src={umamiSrc}
			data-website-id={umamiDataWebsiteId}
			defer
		/>
	)
}

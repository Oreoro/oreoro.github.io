---
/**
 * Compact jump links for longer pages. Each id matches a section heading.
 */
interface Props {
	anchors: { id: string; label: string }[];
	/** Screen-reader label for the list. */
	label?: string;
}

const { anchors, label = "On this page" } = Astro.props;
---

{
	anchors.length > 1 && (
		<nav class="page__anchors" aria-label={label}>
			<p class="page__anchors-label" aria-hidden="true">
				{label}
			</p>
			<ul>
				{anchors.map((anchor) => (
					<li>
						<a href={`#${anchor.id}`}>{anchor.label}</a>
					</li>
				))}
			</ul>
		</nav>
	)
}

---
import * as interfaces from "@/lib/interfaces";
import { getNotionColorToTailwindColor } from "@/utils/style-helpers";
import RichText from "@/components/notion-blocks/RichText.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";

export interface Props {
	block: interfaces.Block | interfaces.List;
	renderChildren?: boolean; // Make this optional
	setId?: boolean;
}

const { block, renderChildren = true, setId = true } = Astro.props;

const listItems = "ListItems" in block ? block.ListItems : [];
---

<ul class="notion-list-ul" id={setId && "Id" in block ? block.Id : undefined}>
	{
		listItems
			.filter((b: interfaces.Block) => b.Type === "bulleted_list_item")
			.map((b: interfaces.Block) => {
				const bulletedListItem = b.BulletedListItem ?? { RichTexts: [], Color: "default" };
				return (
					<li
						class:list={[
							{
								"notion-list-item-colored":
									bulletedListItem.Color &&
									!["default", "default_background", "default-background"].includes(
										bulletedListItem.Color,
									),
								[`${getNotionColorToTailwindColor(bulletedListItem.Color)}`]:
									bulletedListItem.Color &&
									!["default", "default_background", "default-background"].includes(
										bulletedListItem.Color,
									),
							},
						]}
						id={setId ? b.Id : undefined}
					>
						{bulletedListItem.RichTexts.map((richText: interfaces.RichText) => (
							<RichText richText={richText} blockID={b.Id} block={b} />
						))}
						{b.HasChildren && renderChildren && bulletedListItem.Children && (
							<NotionBlocks
								blocks={bulletedListItem.Children}
								renderChildren={renderChildren}
								setId={setId}
							/>
						)}
					</li>
				);
			})
	}
</ul>

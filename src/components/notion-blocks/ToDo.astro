---
import * as interfaces from "@/lib/interfaces.ts";
import { getNotionColorToTailwindColor } from "@/utils/style-helpers";
import RichText from "@/components/notion-blocks/RichText.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";
import Icon from "@/components/ui/Icon.astro";

export interface Props {
	block: interfaces.Block | interfaces.List;
	renderChildren?: boolean; // Make this optional
	setId?: boolean;
}

const { block, renderChildren = true, setId = true } = Astro.props;

const listItems = "ListItems" in block ? block.ListItems : [];
---

<div class="to-do" id={setId && "Id" in block ? block.Id : undefined}>
	{
		listItems
			.filter((b: interfaces.Block) => b.Type === "to_do")
			.map((b: interfaces.Block) => {
				const toDo = b.ToDo ?? { RichTexts: [], Checked: false, Color: "default" };
				return (
					<div class="todo-container" id={setId ? b.Id : undefined}>
						<div
							class:list={[
								"todo-item",
								{
									"todo-item-colored":
										toDo.Color &&
										!["default", "default_background", "default-background"].includes(toDo.Color),
									[`${getNotionColorToTailwindColor(toDo.Color)}`]:
										toDo.Color &&
										!["default", "default_background", "default-background"].includes(toDo.Color),
								},
							]}
						>
							{/* Flex container for the checkbox and text */}
							<div class="todo-checkbox-wrapper">
								{/* Padding for the checkbox */}

								<Icon
									class="todo-checkbox-icon"
									name={toDo.Checked ? "checkbox-checked" : "checkbox-unchecked"}
									aria-label={toDo.Checked ? "checkbox-checked" : "checkbox-unchecked"}
									focusable="false"
								/>
								<span class="rss-only hidden">{toDo.Checked ? "✅" : "⬜"}</span>
							</div>
							<div class="todo-text">
								{/* Container for text, taking up the rest of the space */}
								{toDo.RichTexts.map((richText: interfaces.RichText) => {
									if (toDo.Checked) {
										return (
											<span class="line-through decoration-slate-500/50">
												{/* Block element for the text */}
												<RichText richText={richText} blockID={b.Id} block={b} />
											</span>
										);
									}
									return <RichText richText={richText} blockID={b.Id} block={b} />;
								})}
							</div>
						</div>
						{b.HasChildren && renderChildren && toDo.Children && (
							<div class="mt-1">
								{/* Margin for spacing between the to-do and its children */}
								<NotionBlocks
									blocks={toDo.Children}
									renderChildren={renderChildren}
									setId={setId}
								/>
							</div>
						)}
					</div>
				);
			})
	}
</div>

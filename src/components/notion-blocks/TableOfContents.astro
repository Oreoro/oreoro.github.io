---
import * as interfaces from "@/lib/interfaces.ts";
import { getCurrentHeadings } from "@/lib/blog-helpers.ts";
import { getNotionColorToTailwindColor } from "@/utils/style-helpers";
import type { Heading } from "@/types";

export interface Props {
	block: interfaces.Block;
	setId?: boolean;
}

const { block, setId = true } = Astro.props;
let current_headings = getCurrentHeadings();
---

{
	current_headings && (
		<div class="table-of-contents no-rss" id={setId ? block.Id : undefined}>
			{current_headings.map((heading: Heading) => {
				let indentClass = "";
				if (heading.depth === 2) {
					indentClass = "pl-6";
				} else if (heading.depth === 3) {
					indentClass = "pl-12";
				} else if (heading.depth === 4) {
					indentClass = "pl-[4.5rem]";
				}

				const tocColor = block.TableOfContents?.Color ?? "";

				return (
					<a
						href={`#${heading.slug}`}
						class:list={[
							"table-of-contents block leading-7 hover:font-bold",
							indentClass,
							{
								[`${getNotionColorToTailwindColor(tocColor)} rounded-sm px-1`]:
									tocColor &&
									!["default", "default_background", "default-background"].includes(tocColor),
							},
						]}
						aria-label={`Jump to section: ${heading.text}`}
					>
						{heading.text}
					</a>
				);
			})}
		</div>
	)
}

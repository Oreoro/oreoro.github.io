---
import { AppBskyGraphDefs, AppBskyGraphStarterpack } from "@atproto/api";
import { atUriToStarterPackUri, starterPackOgImage } from "./utils";
import Card from "./card.astro";

interface Props {
	record: AppBskyGraphDefs.StarterPackViewBasic;
}

const { record } = Astro.props;

const packRecord = AppBskyGraphStarterpack.isRecord(record.record) ? record.record : null;
const packName = typeof packRecord?.name === "string" ? packRecord.name : "";
const packDescription =
	typeof packRecord?.description === "string" ? packRecord.description : undefined;
---

<Card
	href={atUriToStarterPackUri(record.uri)}
	image={{
		src: starterPackOgImage(record.uri),
		alt: packName || "Starter pack cover image",
	}}
	avatarUser={record.creator}
	title={packName || ""}
	subtitle={`Starter pack by ${record.creator.displayName}`}
	description={packDescription}
/>

---
import * as interfaces from "@/lib/interfaces.ts";
import { getNotionColorToTailwindColor } from "@/utils/style-helpers";
import RichText from "@/components/notion-blocks/RichText.astro";
import NotionBlocks from "@/components/NotionBlocks.astro";

export interface Props {
	block: interfaces.Block | interfaces.List;
	level: number;
	renderChildren?: boolean; // Make this optional
	setId?: boolean;
}

const { block, level, renderChildren = true, setId = true } = Astro.props;

const listTypes = ["lower-roman", "decimal", "lower-alpha"];
const listItems = "ListItems" in block ? block.ListItems : [];
---

<div class="numbered-list" id={setId && "Id" in block ? block.Id : undefined}>
	<ol
		class="notion-list-ol"
		style={`list-style-type: ${listTypes[level % 3] ?? "decimal"} !important;`}
	>
		{
			listItems
				.filter((b: interfaces.Block) => b.Type === "numbered_list_item")
				.map((b: interfaces.Block) => {
					const numberedListItem = b.NumberedListItem ?? { RichTexts: [], Color: "default" };
					return (
						<li
							class:list={[
								{
									"notion-list-item-colored":
										numberedListItem.Color &&
										!["default", "default_background", "default-background"].includes(
											numberedListItem.Color,
										),
									[`${getNotionColorToTailwindColor(numberedListItem.Color)}`]:
										numberedListItem.Color &&
										!["default", "default_background", "default-background"].includes(
											numberedListItem.Color,
										),
								},
							]}
							id={setId ? b.Id : undefined}
						>
							{numberedListItem.RichTexts.map((richText: interfaces.RichText) => (
								<RichText richText={richText} blockID={b.Id} block={b} />
							))}
							{b.HasChildren && renderChildren && numberedListItem.Children && (
								<NotionBlocks
									blocks={numberedListItem.Children}
									level={level + 1}
									renderChildren={renderChildren}
									setId={setId}
								/>
							)}
						</li>
					);
				})
		}
	</ol>
</div>

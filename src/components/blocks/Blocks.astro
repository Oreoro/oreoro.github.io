---
import type { Block } from "@/data/focuslab";

export interface Props {
	blocks: Block[];
}

const { blocks } = Astro.props;
---

<div class="blk">
	{
		blocks.map((block) => {
			switch (block.type) {
				case "h2":
					return <h2 class="blk-h2">{block.text}</h2>;
				case "h3":
					return <h3 class="blk-h3">{block.text}</h3>;
				case "p":
					return <p class="blk-p">{block.text}</p>;
				case "ul":
					return (
						<ul class="blk-list">
							{block.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					);
				case "ol":
					return (
						<ol class="blk-list blk-list--ol">
							{block.items.map((item) => (
								<li>{item}</li>
							))}
						</ol>
					);
				case "quote":
					return <blockquote class="blk-quote">{block.text}</blockquote>;
				case "callout":
					return (
						<aside class="blk-callout">
							{block.emoji && <span class="blk-callout__icon">{block.emoji}</span>}
							<p>{block.text}</p>
						</aside>
					);
				case "image":
					return (
						<figure class="blk-figure">
							<img src={block.src} alt={block.caption || ""} loading="lazy" decoding="async" />
							{block.caption && <figcaption>{block.caption}</figcaption>}
						</figure>
					);
				case "code":
					return (
						<pre class="blk-code">
							<code>{block.text}</code>
						</pre>
					);
				case "divider":
					return <hr class="blk-divider" />;
				case "stats":
					return (
						<dl class="blk-stats">
							{block.items.map((stat) => (
								<div>
									<dt>{stat.value}</dt>
									<dd>{stat.label}</dd>
								</div>
							))}
						</dl>
					);
				case "cards":
					return (
						<div class="blk-cards">
							{block.items.map((card) => (
								<article class="blk-card">
									<h3>{card.title}</h3>
									<p>{card.text}</p>
								</article>
							))}
						</div>
					);
				default:
					return null;
			}
		})
	}
</div>

<style>
	.blk {
		display: flex;
		flex-direction: column;
		gap: 1.1em;
	}

	.blk-h2 {
		margin: 0.4em 0 0;
		color: var(--color-white);
		font-size: clamp(1.4rem, 3vw, 2rem);
		font-weight: 700;
		line-height: 1.15;
		letter-spacing: -0.02em;
	}

	.blk-h3 {
		margin: 0.2em 0 0;
		color: var(--color-white);
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}

	.blk-p {
		margin: 0;
		color: rgba(255, 255, 255, 0.86);
		line-height: 1.55;
		text-wrap: pretty;
	}

	.blk-list {
		margin: 0;
		padding-left: 1.4ch;
		color: rgba(255, 255, 255, 0.86);
		line-height: 1.55;
	}

	.blk-list li + li {
		margin-top: 0.35em;
	}

	.blk-list--ol {
		padding-left: 2.4ch;
	}

	.blk-quote {
		margin: 0;
		padding-left: 1.1em;
		border-left: 3px solid rgba(255, 255, 255, 0.5);
		color: var(--color-white);
		font-size: 1.15em;
		font-weight: 500;
		line-height: 1.4;
		text-wrap: pretty;
	}

	.blk-callout {
		display: flex;
		gap: 0.7em;
		align-items: flex-start;
		padding: 1em 1.15em;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 0.5em;
		background: rgba(255, 255, 255, 0.12);
	}

	.blk-callout__icon {
		font-size: 1.2em;
		line-height: 1.3;
	}

	.blk-callout p {
		margin: 0;
		color: var(--color-white);
		line-height: 1.5;
	}

	.blk-figure {
		margin: 0.4em 0;
	}

	.blk-figure img {
		width: 100%;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 0.5em;
	}

	.blk-figure figcaption {
		margin-top: 0.5em;
		color: rgba(255, 255, 255, 0.65);
		font-size: 0.85em;
	}

	.blk-code {
		margin: 0;
		padding: 1em 1.15em;
		overflow-x: auto;
		border: 1px solid rgba(255, 255, 255, 0.2);
		border-radius: 0.5em;
		background: rgba(0, 0, 0, 0.28);
		color: #fff;
		font-family: var(--font-family-mono);
		font-size: 0.85em;
		line-height: 1.6;
	}

	.blk-code code {
		font: inherit;
		white-space: pre;
	}

	.blk-divider {
		margin: 0.6em 0;
		height: 1px;
		border: 0;
		background: rgba(255, 255, 255, 0.2);
	}

	.blk-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(9em, 1fr));
		gap: 1em;
		margin: 0.4em 0;
	}

	.blk-stats dt {
		color: var(--color-white);
		font-size: clamp(1.6rem, 4vw, 2.6rem);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.blk-stats dd {
		margin: 0.2em 0 0;
		color: rgba(255, 255, 255, 0.7);
		font-size: 0.85em;
		line-height: 1.4;
	}

	.blk-cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(13em, 1fr));
		gap: 0.8em;
		margin: 0.4em 0;
	}

	.blk-card {
		padding: 1em 1.1em;
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 0.5em;
		background: rgba(255, 255, 255, 0.06);
	}

	.blk-card h3 {
		margin: 0 0 0.35em;
		color: var(--color-white);
		font-size: 1em;
		font-weight: 700;
	}

	.blk-card p {
		margin: 0;
		color: rgba(255, 255, 255, 0.72);
		font-size: 0.88em;
		line-height: 1.5;
	}
</style>
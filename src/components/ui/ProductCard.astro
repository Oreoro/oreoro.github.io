---
import type { Product } from "@/data/products";
import Arrow from "@/components/ui/Arrow.astro";

interface Props {
	product: Product;
}

const { product } = Astro.props;
const headingId = `product-${product.slug}`;
---

<a
	class="product-card"
	href={product.url}
	target="_blank"
	rel="noopener"
	aria-labelledby={headingId}
>
	<div class="product-card__head">
		<h2 id={headingId}>{product.name}</h2>
		<span class="product-card__status">{product.selfHosted ? "Self-hosted" : "Live"}</span>
	</div>
	<p class="product-card__tagline">{product.tagline}</p>
	<p class="product-card__summary">{product.summary}</p>
	<span class="product-card__cta">Visit website <Arrow direction="external" /></span>
</a>

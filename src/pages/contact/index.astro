---
import PageLayout from "@/layouts/Base.astro";
import Arrow from "@/components/ui/Arrow.astro";
import { getNavLink } from "@/lib/blog-helpers";
import { site } from "@/data/focuslab";
---

<PageLayout
	meta={{
		title: "Contact",
		description:
			"Contact Focus Lab in Islamabad — email, phone, or WhatsApp. Tell us what you're building and what done looks like.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Contact</p>
			<h1>Tell us what you're building.</h1>
			<p>
				Four lines is plenty — the problem, who it affects, what done looks like, and
				your timeline.
			</p>
		</div>

		<div class="page__content content">
			<h2 id="include">What to include</h2>
			<div class="includes">
				<div>
					<h3>The problem.</h3>
					<p>What's broken or missing today, in a sentence.</p>
				</div>
				<div>
					<h3>Who hits it.</h3>
					<p>How many people, and how often.</p>
				</div>
				<div>
					<h3>What done looks like.</h3>
					<p>The finished product, described simply.</p>
				</div>
				<div>
					<h3>Your timeline.</h3>
					<p>When you need it, and what's already committed.</p>
				</div>
			</div>


			<h2 id="reach">Where to reach us</h2>
			<dl class="contact-list">
				<div>
					<dt>Email</dt>
					<dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
				</div>
				<div>
					<dt>Phone</dt>
					<dd><a href={`tel:${site.phone.replace(/\s+/g, "")}`}>{site.phone}</a></dd>
				</div>
				<div>
					<dt>WhatsApp</dt>
					<dd>
						<a href={site.whatsappHref} target="_blank" rel="noopener">
							{site.whatsapp}
						</a>
						<small class="contact-list__note">We reply fastest on WhatsApp.</small>
					</dd>
				</div>
				<div>
					<dt>Studio</dt>
					<dd>{site.location}</dd>
				</div>
				<div>
					<dt>Time</dt>
					<dd>Pakistan Standard Time (PKT, UTC+5)</dd>
				</div>
				<div>
					<dt>LinkedIn</dt>
					<dd>
						<a href="https://www.linkedin.com/company/110646093/" target="_blank" rel="noopener">
							focuslab
						</a>
					</dd>
				</div>
			</dl>

			<div class="panel">
				<h3 class="panel__title">A note on fit</h3>
				<div class="panel__body">
					<p>
						Partner work only when the fit is mutual. If we're not right, we say so early.
					</p>
				</div>
				<div class="panel__actions">
					<a class="button" href={`mailto:${site.email}`}>Email us <Arrow /></a>
					<a class="button button--ghost" href={getNavLink("/studio/")}>The studio</a>
				</div>
			</div>
		</div>
	</div>
</PageLayout>

<style>
	.includes {
		display: grid;
		gap: 1.4em;
	}

	.includes > div {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}

	.includes h3,
	.includes p {
		margin: 0;
	}

	.contact-list {
		display: grid;
		gap: 1.4em;
		grid-template-columns: 1fr;
		margin: 0;
	}

	@media (min-width: 48em) {
		.includes,
		.contact-list {
			column-gap: 3rem;
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.contact-list div {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}

	.contact-list dt {
		color: color-mix(in srgb, var(--color-ink) var(--ink-muted), transparent);
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.contact-list dd a {
		display: inline-flex;
		align-items: center;
		min-height: 44px;
		padding: 0.2em 0;
	}

	.contact-list dd {
		margin: 0;
		color: var(--color-ink);
		font-size: 1.2em;
		font-weight: 400;
	}

	.contact-list__note {
		color: color-mix(in srgb, var(--color-ink) var(--ink-muted), transparent);
		display: block;
		font-size: 0.8em;
		margin-top: 0.1em;
	}
</style>

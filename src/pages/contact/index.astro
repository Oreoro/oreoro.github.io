---
import PageLayout from "@/layouts/Base.astro";
import PageAnchors from "@/components/layout/PageAnchors.astro";
import { getNavLink } from "@/lib/blog-helpers";
import { site } from "@/data/focuslab";
---

<PageLayout
	meta={{
		title: "Contact",
		description:
			"Tell Focus Lab what you're building and what done looks like. Four lines is plenty — you'll get a straight answer, usually within a day.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Contact</p>
			<h1>Tell us what you're building.</h1>
			<p>
				Tell us what you're building and what done looks like. We'll reply with a straight answer.
			</p>
			<PageAnchors
				anchors={[
					{ id: "include", label: "What to include" },
					{ id: "reach", label: "Where to reach us" },
				]}
			/>
		</div>

		<div class="page__content content">
			<h2 id="include">What to include</h2>
			<p>You don't need a brief. Four lines is plenty, and we'd rather have them than not.</p>
			<ol class="numbered">
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">The problem.</h3>
						<p>What's broken or missing today, in a sentence.</p>
					</div>
				</li>
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">Who hits it.</h3>
						<p>How many people have this problem, and how often.</p>
					</div>
				</li>
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">What done looks like.</h3>
						<p>The version of the world that's obviously better when we're finished.</p>
					</div>
				</li>
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">Your timeline.</h3>
						<p>When you need it, and what's already committed.</p>
					</div>
				</li>
			</ol>

			<h2 id="reach">Where to reach us</h2>
			<dl class="contact-list">
				<div>
					<dt>Email</dt>
					<dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
				</div>
				<div>
					<dt>Phone</dt>
					<dd><a href={`tel:${site.phone.replace(/\s+/g, "")}`}>{site.phone}</a></dd>
				</div>
				<div>
					<dt>Studio</dt>
					<dd>{site.location}</dd>
				</div>
				<div>
					<dt>LinkedIn</dt>
					<dd>
						<a href="https://www.linkedin.com/company/110646093/" target="_blank" rel="noopener">
							focuslab
						</a>
					</dd>
				</div>
			</dl>

			<div class="panel">
				<h3 class="panel__title">A note on fit</h3>
				<div class="panel__body">
					<p>
						We take on partner work only when there's a mutual fit: a real problem, a clear owner,
						and room to decide how to solve it. If we're not the right studio for it, we'll say so
						early and point you somewhere better.
					</p>
					<p>
						Read <a href={getNavLink("/studio/")}>what we believe</a> first — it'll tell you faster than
						an email will.
					</p>
				</div>
				<div class="panel__actions">
					<a class="button" href={`mailto:${site.email}`}>Email us <span>&rarr;</span></a>
					<a class="button button--ghost" href={getNavLink("/studio/")}>The studio</a>
				</div>
			</div>
		</div>
	</div>
</PageLayout>

<style>
	.contact-list {
		display: flex;
		flex-direction: column;
		gap: 1.4em;
		margin: 0;
	}

	.contact-list div {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}

	.contact-list dt {
		color: color-mix(in srgb, var(--color-ink) var(--ink-muted), transparent);
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* The address links are 22px tall and are the whole point of the page.
	   Vertical padding on an inline element extends the tap area without
	   changing the line box, so the address keeps its own wrapping. */
	.contact-list dd a {
		padding: 0.2em 0;
	}

	.contact-list dd {
		margin: 0;
		color: var(--color-ink);
		font-size: 1.2em;
		font-weight: 500;
	}
</style>

---
import PageLayout from "@/layouts/Base.astro";
import { entryDescription, stream, type StreamKind } from "@/data/stream";
import { getNavLink } from "@/lib/blog-helpers";

export function getStaticPaths() {
	return stream.map((entry, index) => ({
		params: { num: entry.num },
		props: { entry, index },
	}));
}

const { entry, index } = Astro.props;
const nextEntry = stream[(index + 1) % stream.length]!;
const previousEntry = stream[(index - 1 + stream.length) % stream.length]!;
const nextHref = getNavLink(`/${nextEntry.num}`);
const previousHref = getNavLink(`/${previousEntry.num}`);

const kindLabel: Record<StreamKind, string> = {
	note: "Note",
	launch: "Launch",
	essay: "Essay",
	quote: "Quote",
	link: "Link",
};

const ctaLabel =
	entry.kind === "essay" || entry.kind === "quote" ? "Read the original" : "Open link";

/**
 * The stream index is split into windows of 36.
 *
 * Reproducing all 106 entries on every entry page was fine at 30 and is a
 * 3000px wall at 106 — you had to scroll past a hundred bare numbers to get
 * out of one. A window keeps the page about a screen and a half, and the
 * windows are aligned to page boundaries (00–35, 36–71, 72–105) rather than
 * centred on the current entry, so the same entry always shows the same
 * neighbours.
 *
 * Windows need no pagination UI. The footer steps one entry at a time, so
 * walking from 35 to 36 crosses into the next window on its own, and every
 * entry is still reachable directly at its own URL.
 */
const WINDOW_SIZE = 36;
const windowStart = Math.floor(index / WINDOW_SIZE) * WINDOW_SIZE;
const windowEnd = Math.min(windowStart + WINDOW_SIZE, stream.length);
const windowEntries = stream.slice(windowStart, windowEnd);

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
---

<PageLayout
	meta={{
		title: `${entry.num}. ${entry.label}`,
		description: entryDescription(entry),
		articleDate: entry.date,
		jsonLd: {
			"@context": "https://schema.org",
			"@type": "Article",
			headline: entry.label,
			description: entryDescription(entry),
			datePublished: entry.date,
			url: Astro.url.href,
			mainEntityOfPage: Astro.url.href,
			author: entry.source
				? { "@type": "Person", name: entry.source }
				: { "@id": `${siteOrigin}/#organization` },
			publisher: { "@id": `${siteOrigin}/#organization` },
		},
	}}
	themeIndex={index}
	footerNext={{ href: `/${nextEntry.num}`, label: `${nextEntry.num}. ${nextEntry.label}` }}
>
	<h1 class="visually-hidden">{entry.num}. {entry.label}</h1>

	<section class="signal signal--clone" data-signal={index - windowStart}>
		<header class="signal__header" tabindex="-1" autofocus>
			<h2 aria-label={`${kindLabel[entry.kind]}: ${entry.label}`}>
				<span>{entry.num}.</span>
				<strong>{entry.label}</strong>
			</h2>
		</header>
		<div class="signal__content content">
			<p class="entry__meta">
				<span class="entry__kind">{kindLabel[entry.kind]}</span>
				{" · "}
				{entry.date}
				{entry.source && ` · ${entry.source}`}
			</p>

			<Fragment set:html={entry.content} />

			{
				entry.url && (
					<p>
						<a class="button" href={entry.url} target="_blank" rel="noopener">
							{ctaLabel} <span>&rarr;</span>
						</a>
					</p>
				)
			}
		</div>
	</section>

	<div class="cluster cluster--signal">
		{
			windowEntries.map((item, itemIndex) => (
				<section class="signal" data-signal={itemIndex}>
					<header class="signal__header">
						<a
							href={getNavLink(`/${item.num}`)}
							aria-label={`${kindLabel[item.kind]}: ${item.label}`}
						>
							<dl>
								<dt>{item.num}.</dt>
								<dd>
									{item.label}
									<span class="signal__meta">{item.source ?? kindLabel[item.kind]}</span>
								</dd>
							</dl>
						</a>
					</header>
				</section>
			))
		}
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
		aria-label="Stream navigation"
	>
		<a href={nextHref} aria-label={`Next: ${nextEntry.label}`} tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>

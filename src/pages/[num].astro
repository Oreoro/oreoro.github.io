---
import PageLayout from "@/layouts/Base.astro";
import Arrow from "@/components/ui/Arrow.astro";
import { entryDescription, stream, type StreamKind } from "@/data/stream";
import { getNavLink } from "@/lib/blog-helpers";

export function getStaticPaths() {
	return stream.map((entry, index) => ({
		params: { num: entry.num },
		props: { entry, index },
	}));
}

const { entry, index } = Astro.props;
const nextEntry = stream[(index + 1) % stream.length]!;
const previousEntry = stream[(index - 1 + stream.length) % stream.length]!;
const nextHref = getNavLink(`/${nextEntry.num}`);
const previousHref = getNavLink(`/${previousEntry.num}`);

const kindLabel: Record<StreamKind, string> = {
	note: "Note",
	launch: "Launch",
	essay: "Essay",
	quote: "Quote",
	link: "Link",
};

const ctaLabel =
	entry.kind === "essay" || entry.kind === "quote" ? "Read the original" : "Open link";

/* Keep the nearby 36 entries available, without putting them before the article. */
const WINDOW_SIZE = 36;
const windowStart = Math.floor(index / WINDOW_SIZE) * WINDOW_SIZE;
const windowEnd = Math.min(windowStart + WINDOW_SIZE, stream.length);
const windowEntries = stream.slice(windowStart, windowEnd);

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
---

<PageLayout
	meta={{
		title: `${entry.num}. ${entry.label}`,
		description: entryDescription(entry),
		articleDate: entry.date,
		jsonLd: {
			"@context": "https://schema.org",
			"@type": "Article",
			headline: entry.label,
			description: entryDescription(entry),
			datePublished: entry.date,
			url: Astro.url.href,
			mainEntityOfPage: Astro.url.href,
			author: entry.source
				? { "@type": "Person", name: entry.source }
				: { "@id": `${siteOrigin}/#organization` },
			publisher: { "@id": `${siteOrigin}/#organization` },
		},
	}}
>
	<div class="page">
		<article class="entry">
			<p class="entry__breadcrumb">
				<a href={getNavLink("/stream/")}>The stream</a><span aria-hidden="true">/</span><span
					>{entry.num}</span
				>
			</p>
			<header class="entry__header">
				<h1>{entry.label}</h1>
				<p class="entry__meta">
					<span class="entry__kind">{kindLabel[entry.kind]}</span>
					<time datetime={entry.date}>{entry.date}</time>
					{entry.source && <span>{entry.source}</span>}
				</p>
			</header>
			<div class="entry__content content">
				<Fragment set:html={entry.content} />
				{
					entry.url && (
						<p>
							<a class="button" href={entry.url} target="_blank" rel="noopener">
								{ctaLabel} <Arrow direction="external" />
							</a>
						</p>
					)
				}
			</div>
		</article>

		<nav
			class="entry entry__navigation"
			data-next={nextHref}
			data-previous={previousHref}
			aria-label="Stream navigation"
		>
			<a href={previousHref} rel="prev"
				><small>← Previous · {previousEntry.num}</small><span>{previousEntry.label}</span></a
			>
			<a href={nextHref} rel="next"
				><small>Next · {nextEntry.num} →</small><span>{nextEntry.label}</span></a
			>
		</nav>
		<details class="entry entry__archive">
			<summary
				>Explore entries {windowEntries[0]!.num}–{
					windowEntries[windowEntries.length - 1]!.num
				}</summary
			>
			<ul class="stream-list">
				{
					windowEntries.map((item) => (
						<li>
							<a
								href={getNavLink(`/${item.num}/`)}
								aria-current={item.num === entry.num ? "page" : undefined}
							>
								<>
									<span class="stream-list__number">{item.num}.</span>
									<span class="stream-list__title">{item.label}</span>
								</>
							</a>
						</li>
					))
				}
			</ul>
			<p><a href={getNavLink("/stream/")}>Browse the complete stream →</a></p>
		</details>
	</div>
</PageLayout>

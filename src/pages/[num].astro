---
import PageLayout from "@/layouts/Base.astro";
import Arrow from "@/components/ui/Arrow.astro";
import { entryDescription, stream, streamKindLabels as kindLabel } from "@/data/stream";
import { getNavLink } from "@/lib/blog-helpers";

export function getStaticPaths() {
	return stream.map((entry, index) => ({
		params: { num: entry.num },
		props: { entry, index },
	}));
}

const { entry, index } = Astro.props;
const nextEntry = stream[(index + 1) % stream.length]!;
const previousEntry = stream[(index - 1 + stream.length) % stream.length]!;
const nextHref = getNavLink(`/${nextEntry.num}`);
const previousHref = getNavLink(`/${previousEntry.num}`);

const ctaLabel = "Open link";

/* A compact window around the current entry, plus a link to the full stream.
   The article (clone) always sits at its position inside this window. */
const WINDOW_SIZE = 5;
const half = Math.floor(WINDOW_SIZE / 2);
const windowStart = Math.max(0, Math.min(index - half, stream.length - WINDOW_SIZE));
const windowEnd = Math.min(windowStart + WINDOW_SIZE, stream.length);
const windowEntries = stream.slice(windowStart, windowEnd);

const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
---

<PageLayout
	meta={{
		title: `${entry.num}. ${entry.label}`,
		description: entryDescription(entry),
		articleDate: entry.date,
		jsonLd: {
			"@context": "https://schema.org",
			"@type": "Article",
			headline: entry.label,
			description: entryDescription(entry),
			datePublished: entry.date,
			url: Astro.url.href,
			mainEntityOfPage: Astro.url.href,
			author: entry.source
				? { "@type": "Person", name: entry.source }
				: { "@id": `${siteOrigin}/#organization` },
			publisher: { "@id": `${siteOrigin}/#organization` },
		},
	}}
	footerNext={{ href: `/${nextEntry.num}`, label: `${nextEntry.num}. ${nextEntry.label}` }}
>
	<section class="signal signal--clone" data-signal={index - windowStart}>
		<header class="signal__header">
			<p class="entry__meta">
				<span class="entry__kind">{kindLabel[entry.kind]}</span>
				{" · "}
				<time datetime={entry.date}>{entry.date}</time>
				{entry.source && ` · ${entry.source}`}
			</p>
			<h1 aria-label={`${kindLabel[entry.kind]}: ${entry.label}`}>
				<span>{entry.num}.</span>
				<strong>{entry.label}</strong>
			</h1>
		</header>
		<div class="signal__content content">
			<Fragment set:html={entry.content} />

			{
				entry.url && (
					<p>
						<a class="button" href={entry.url} target="_blank" rel="noopener">
							{ctaLabel} <Arrow direction="external" />
						</a>
					</p>
				)
			}

			<nav
				class="entry__navigation"
				data-next={nextHref}
				data-previous={previousHref}
				aria-label="Stream navigation"
			>
				<a href={previousHref} rel="prev"
					><small>← Previous · {previousEntry.num}</small><span>{previousEntry.label}</span></a
				>
				<a href={nextHref} rel="next"
					><small>Next · {nextEntry.num} →</small><span>{nextEntry.label}</span></a
				>
			</nav>
		</div>
	</section>

	<div class="cluster cluster--signal" role="navigation" aria-label="Nearby stream entries">
		{
			windowEntries.map((item, itemIndex) => (
				<section class="signal" data-signal={itemIndex}>
					<header class="signal__header">
						<a
							href={getNavLink(`/${item.num}`)}
							aria-label={`${kindLabel[item.kind]}: ${item.label}`}
							aria-current={item.num === entry.num ? "page" : undefined}
						>
							<dl>
								<dt>{item.num}.</dt>
								<dd>
									{item.label}
									<span class="signal__meta">{item.source ?? kindLabel[item.kind]}</span>
								</dd>
							</dl>
						</a>
					</header>
				</section>
			))
		}
		<p class="cluster__more">
			<a href={getNavLink("/stream/")}>
				See all {stream.length} entries <Arrow direction="forward" />
			</a>
		</p>
	</div>

	<noscript>
		<style is:inline>
			html body.signals-shell .cluster--signal:not(.cluster--loaded),
			html body.signals-shell .cluster--signal .signal {
				display: block;
				opacity: 1;
			}
			html body.signals-shell .cluster--signal .signal .signal__header a dl dd {
				opacity: 1;
			}
		</style>
	</noscript>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
		aria-label="Next stream entry"
	>
		<a href={nextHref} aria-label={`Next: ${nextEntry.label}`}></a>
	</div>

	<div class="origin"></div>
</PageLayout>

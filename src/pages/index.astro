---
import PageLayout from "@/layouts/Base.astro";
import { stream } from "@/data/stream";
import { getNavLink } from "@/lib/blog-helpers";

const nextHref = getNavLink(`/${stream[0]!.num}`);
const previousHref = getNavLink(`/${stream[stream.length - 1]!.num}`);
---

<PageLayout
	meta={{
		title: "Focus Lab",
		description:
			"Focus Lab is a product-led studio. We design, build, and run our own software — and partner with a small number of teams to do the same.",
	}}
>
	<h1 class="visually-hidden">Focus Lab — a product-led studio</h1>

	<div class="cluster cluster--index">
		{
			stream.map((entry) => (
				<section class="signal">
					<header class="signal__header">
						<a href={getNavLink(`/${entry.num}`)} aria-label={`${entry.num}. ${entry.label}`}>
							<dl>
								<dt>{entry.num}.</dt>
								<dd>{entry.label}</dd>
							</dl>
							<time class="signal__date" datetime={entry.date}>
								{entry.date}
							</time>
						</a>
					</header>
				</section>
			))
		}
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
		aria-label="Entry navigation"
	>
		<a href={nextHref} aria-label={`Next: ${stream[0]!.label}`} tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
import { stream, streamKindLabels as kindLabel } from "@/data/stream";
import { getNavLink } from "@/lib/blog-helpers";

const firstEntry = stream[0]!;
const lastEntry = stream[stream.length - 1]!;
const nextHref = getNavLink(`/${firstEntry.num}`);
const previousHref = getNavLink(`/${lastEntry.num}`);

const metaFor = (entry: (typeof stream)[number]) => entry.source ?? kindLabel[entry.kind];
---

<PageLayout
	meta={{
		title: "Focus Lab",
		description:
			"Focus Lab is a product studio in Islamabad. We build and run Urban Events, WorkProof, and Fixer.",
	}}
	footerNext={{ href: `/${firstEntry.num}`, label: `${firstEntry.num}. ${firstEntry.label}` }}
>
	<div class="page__headline page__headline--home">
		<p class="page__kicker">Focus Lab · Islamabad</p>
		<h1>A product studio.</h1>
		<p>
			We build and operate our own software — Urban Events, WorkProof, and Fixer — and
			take on a limited amount of partner work. The stream below covers product
			launches, updates, and how we work, newest first.
		</p>
	</div>

	<div class="cluster cluster--index">
		{
			stream.map((entry) => (
				<section class="signal">
					<header class="signal__header">
						<a
							href={getNavLink(`/${entry.num}`)}
							aria-label={`${kindLabel[entry.kind]}: ${entry.label}`}
						>
							<dl>
								<dt>{entry.num}.</dt>
								<dd>
									{entry.label}
									<span class="signal__meta">{metaFor(entry)}</span>
								</dd>
							</dl>
						</a>
					</header>
				</section>
			))
		}
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
		aria-label="Stream navigation"
	>
		<a href={nextHref} aria-label={`Next: ${firstEntry.label}`}></a>
	</div>

	<div class="origin"></div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
import { site } from "@/data/focuslab";
import { signals } from "@/data/signals";
import { getNavLink } from "@/lib/blog-helpers";

const nextHref = getNavLink(`/${signals[0]!.num}`);
const previousHref = getNavLink(`/${signals[signals.length - 1]!.num}`);
---

<PageLayout
	meta={{
		title: site.name,
		description: site.description,
		ogImage: "/og-image/home.png",
	}}
>
	<div class="cluster cluster--index">
		{signals.map((signal) => (
			<section class="signal">
				<header class="signal__header">
					<a href={getNavLink(`/${signal.num}`)} aria-label={`Signal ${signal.num}. ${signal.label}`}>
						<dl>
							<dt>{signal.num}.</dt>
							<dd>{signal.label}</dd>
						</dl>
					</a>
				</header>
			</section>
		))}
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
	>
		<a href={nextHref} aria-label={`Next Signal: ${signals[0]!.label}`} tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>
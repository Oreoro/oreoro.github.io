---
import PageLayout from "@/layouts/Base.astro";
import { stream, type StreamKind } from "@/data/stream";
import { getNavLink } from "@/lib/blog-helpers";

const firstEntry = stream[0]!;
const lastEntry = stream[stream.length - 1]!;
const nextHref = getNavLink(`/${firstEntry.num}`);
const previousHref = getNavLink(`/${lastEntry.num}`);

const kindLabel: Record<StreamKind, string> = {
	note: "Note",
	launch: "Launch",
	essay: "Essay",
	quote: "Quote",
	link: "Link",
};

const metaFor = (entry: (typeof stream)[number]) => entry.source ?? kindLabel[entry.kind];
---

<PageLayout
	meta={{
		title: "Focus Lab",
		description:
			"The Focus Lab stream — a feed of what we are building, reading, and thinking about. A product studio in Islamabad: Urban Events, WorkProof, and Fixer.",
	}}
	footerNext={{ href: `/${firstEntry.num}`, label: `${firstEntry.num}. ${firstEntry.label}` }}
>
	<h1 class="visually-hidden">Focus Lab — a product studio</h1>

	<div class="cluster cluster--index">
		{
			stream.map((entry) => (
				<section class="signal">
					<header class="signal__header">
						<a
							href={getNavLink(`/${entry.num}`)}
							aria-label={`${kindLabel[entry.kind]}: ${entry.label}`}
						>
							<dl>
								<dt>{entry.num}.</dt>
								<dd>
									{entry.label}
									<span class="signal__meta">{metaFor(entry)}</span>
								</dd>
							</dl>
						</a>
					</header>
				</section>
			))
		}
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
		aria-label="Stream navigation"
	>
		<a href={nextHref} aria-label={`Next: ${firstEntry.label}`} tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>

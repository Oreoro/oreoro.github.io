---
import PageLayout from "@/layouts/Base.astro";

const assets = [
	{
		label: "37signals Logo",
		image: "/assets/downloads/37signals-logo.png",
		href: "https://37signals.com/downloads/37signals-logo.zip",
	},
	{
		label: "37signals Symbol",
		image: "/assets/downloads/37signals-symbol.png",
		href: "https://37signals.com/downloads/37signals-symbol.zip",
	},
	{
		label: "Basecamp Logo",
		image: "/assets/downloads/basecamp-logo.png",
		href: "https://37signals.com/downloads/basecamp-logo.zip",
	},
	{
		label: "Basecamp Symbol",
		image: "/assets/downloads/basecamp-symbol.png",
		href: "https://37signals.com/downloads/basecamp-symbol.zip",
	},
	{
		label: "Campfire Logo",
		image: "/assets/downloads/campfire-logo.png",
		href: "https://37signals.com/downloads/campfire-logo.zip",
	},
	{
		label: "HEY Logo",
		image: "/assets/downloads/hey-logo.png",
		href: "https://37signals.com/downloads/hey-logo.zip",
	},
	{
		label: "HEY Symbol",
		image: "/assets/downloads/hey-symbol.png",
		href: "https://37signals.com/downloads/hey-symbol.zip",
	},
	{
		label: "HEY Icon",
		image: "/assets/downloads/hey-icon.png",
		href: "https://37signals.com/downloads/hey-icon.zip",
	},
	{
		label: "HEY Calendar Icon",
		image: "/assets/downloads/hey-calendar-icon.png",
		href: "https://37signals.com/downloads/hey-calendar-icon.zip",
	},
	{
		label: "Omarchy Logo",
		image: "/assets/downloads/omarchy-logo.png",
		href: "https://37signals.com/downloads/omarchy-logo.zip",
	},
	{
		label: "Omarchy Symbol",
		image: "/assets/downloads/omarchy-symbol.png",
		href: "https://37signals.com/downloads/omarchy-symbol.zip",
	},
	{
		label: "ONCE Logo",
		image: "/assets/downloads/once-logo.png",
		href: "https://37signals.com/downloads/once-logo.zip",
	},
	{
		label: "Rails Logo",
		image: "/assets/downloads/rails-logo.png",
		href: "https://37signals.com/downloads/rails-logo.zip",
	},
	{
		label: "Rails Symbol",
		image: "/assets/downloads/rails-symbol.png",
		href: "https://37signals.com/downloads/rails-symbol.zip",
	},
	{
		label: "Rails Badge",
		image: "/assets/downloads/rails-badge.png",
		href: "https://37signals.com/downloads/rails-badge.zip",
	},
	{
		label: "Writebook Logo",
		image: "/assets/downloads/writebook-logo.png",
		href: "https://37signals.com/downloads/writebook-logo.zip",
	},
];
---

<PageLayout
	meta={{
		title: "Downloads",
		description: "Logos, symbols and brand assets.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h1>Brand Downloads</h1>
		</div>

		<div class="downloads">
			<div class="downloads__container">
				<div class="downloads__group">
					{
						assets.map((asset) => (
							<a download href={asset.href}>
								<figure>
									<img src={asset.image} alt={asset.label} />
									<figcaption>{asset.label}</figcaption>
								</figure>
							</a>
						))
					}
				</div>
			</div>
		</div>
	</div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout
	meta={{
		title: "Sign up",
		description: "Get occasional updates.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h1>Sign up</h1>
			<p>Sign up to get occasional updates from Focus Lab. No spam, ever.</p>
		</div>

		<div class="page__body">
			<div class="signup signup--mc content">
				<p>
					We'll send you the occasional update about what we're working on. We will never share your
					email, or use it for any other purpose.
				</p>
				<form
					novalidate
					action="#"
					method="post"
					id="mc-embedded-subscribe-form"
					name="mc-embedded-subscribe-form"
					target="_self"
				>
					<div aria-hidden="true" style="position: absolute; left: -5000px;">
						<input type="text" name="b_honeypot" tabindex="-1" value="" />
					</div>
					<input
						type="email"
						placeholder="you@example.com"
						spellcheck="false"
						value=""
						name="EMAIL"
						id="mce-EMAIL"
					/>
					<button
						class="button button--theme"
						type="submit"
						name="subscribe"
						id="mc-embedded-subscribe"
					>
						Subscribe
					</button>
				</form>
			</div>
		</div>
	</div>
</PageLayout>

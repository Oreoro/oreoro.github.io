---
import PageLayout from "@/layouts/Base.astro";
---

<PageLayout
	meta={{
		title: "Sign up",
		description: "Get occasional updates.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h1>Sign up</h1>
			<p>Placeholder intro. Replace with your own copy.</p>
		</div>

		<div class="page__body">
			<div class="signup signup--mc content">
				<p>Placeholder copy. Replace with your own.</p>
				<form
					novalidate
					action="#"
					method="post"
					id="mc-embedded-subscribe-form"
					name="mc-embedded-subscribe-form"
					target="_self"
				>
					<div aria-hidden="true" style="position: absolute; left: -5000px;">
						<input type="text" name="b_honeypot" tabindex="-1" value="" />
					</div>
					<input
						type="email"
						placeholder="you@example.com"
						spellcheck="false"
						value=""
						name="EMAIL"
						id="mce-EMAIL"
					/>
					<button class="button button--theme" type="submit" name="subscribe" id="mc-embedded-subscribe">
						Subscribe
					</button>
				</form>
			</div>
		</div>
	</div>
</PageLayout>
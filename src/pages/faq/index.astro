---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";

const faqs = [
	{
		q: "What does Focus Lab do?",
		a: "We're a product-led studio. We design, build, and run our own software — and partner with a small number of teams to do the same.",
	},
	{
		q: "How do you price?",
		a: "We price the work, not the hours. You get a scope, a number, and a date before we start. If the scope changes, we say so before it becomes a surprise.",
	},
	{
		q: "How long is a project?",
		a: "Most engagements start with a short, paid discovery. From there we work in short cycles and ship a working slice early, so you're never waiting on a big reveal.",
	},
	{
		q: "Who owns the work?",
		a: "You do. Code, design, and content are yours. We hand over what you need to run it — or we keep running it with you.",
	},
	{
		q: "What do you build with?",
		a: "Boring, proven tools: TypeScript, Postgres, Cloudflare, Shopify, Framer. You can see the whole list on our stack page.",
	},
	{
		q: "Do you work remotely?",
		a: "Yes. We're a small studio and we work where we work best. We keep communication written and asynchronous by default.",
	},
	{
		q: "How do we start?",
		a: "Tell us what you're building and what done looks like. We'll reply with a straight answer about whether we're a fit.",
	},
];
---

<PageLayout
	meta={{
		title: "FAQ",
		description: "Common questions about working with Focus Lab.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h6>FAQ</h6>
			<h1>Questions, answered.</h1>
			<p>The things people ask before they get in touch.</p>
		</div>

		<div class="page__content content">
			{
				faqs.map((faq) => (
					<>
						<h2>{faq.q}</h2>
						<p>{faq.a}</p>
					</>
				))
			}

			<hr class="ornament" />

			<p>
				Still curious? <a href={getNavLink("/contact/")}>Ask us directly</a>.
			</p>
		</div>
	</div>
</PageLayout>

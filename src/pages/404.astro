---
import PageLayout from "@/layouts/Base.astro";
import Arrow from "@/components/ui/Arrow.astro";
import { getNavLink } from "@/lib/blog-helpers";

const meta = {
	title: "Page not found",
	description: "That page doesn't exist. Here's the way back.",
	robots: "noindex, follow",
};
---

<PageLayout meta={meta}>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">404</p>
			<h1>That page doesn't exist.</h1>
			<p>
				The link is broken or the page has moved. No harm done — everything worth seeing is one
				click away.
			</p>
		</div>

		<div class="page__body">
			<p class="page__actions">
				<a class="button" href={getNavLink("/")}>Back home <Arrow /></a>
				<a class="button button--ghost" href={getNavLink("/studio/")}>See the studio</a>
			</p>
		</div>
	</div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
import { stackGroups, principles } from "@/data/focuslab";
import { getNavLink } from "@/lib/blog-helpers";
import "@/styles/stack.css";

const nextHref = getNavLink("/work/");
const previousHref = getNavLink("/capabilities/");
---

<PageLayout
	meta={{
		title: "Stack",
		description:
			"The languages, frameworks, infrastructure, and AI tooling Focus Lab uses to build and operate products.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h6>Stack</h6>
			<h1>The tools we reach for.</h1>
			<p>
				Focus Lab is a technical product team. We pick boring, proven technology and push it hard.
			</p>
		</div>

		<div class="page__content">
			<div class="stack">
				{stackGroups.map((group, groupIndex) => (
					<section
						class="stack__group"
						id={group.title.toLowerCase().replace(/[^a-z]+/g, "-")}
						style={`--stack-index:${groupIndex}`}
					>
						<header class="stack__header">
							<h2 class="stack__title">{group.title}</h2>
							<p class="stack__note">{group.note}</p>
						</header>
						<ul class="stack__items">
							{group.items.map((item, itemIndex) => (
								<li class="stack__item" style={`--stack-item-index:${itemIndex}`}>
									<span class="stack__name">{item.name}</span>
									<span class="stack__desc">{item.note}</span>
								</li>
							))}
						</ul>
					</section>
				))}

				<section class="stack__principles" id="principles">
					<h2 class="stack__title">Principles</h2>
					<dl class="stack__principles-list">
						{principles.map((principle) => (
							<div class="stack__principle">
								<dt>{principle.title}</dt>
								<dd>{principle.body}</dd>
							</div>
						))}
					</dl>
				</section>
			</div>

			<div class="stack__cta">
				<p>Building something technical? We're open to contract work.</p>
				<a class="button button--theme" href={getNavLink("/contact/")}>
					Start a project <span>&rarr;</span>
				</a>
			</div>
		</div>
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
	>
		<a href={nextHref} aria-label="Next: Work" tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>
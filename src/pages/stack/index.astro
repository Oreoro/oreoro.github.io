---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";

interface StackItem {
	name: string;
	logo?: string;
}

const groups: { title: string; note: string; items: StackItem[] }[] = [
	{
		title: "Frontend",
		note: "Fast by default, accessible always.",
		items: [
			{ name: "Astro", logo: "astro" },
			{ name: "React", logo: "react" },
			{ name: "TypeScript", logo: "typescript" },
			{ name: "Tailwind CSS", logo: "tailwindcss" },
			{ name: "Vite", logo: "vite" },
		],
	},
	{
		title: "Backend & data",
		note: "Small, typed services.",
		items: [
			{ name: "Node.js", logo: "nodedotjs" },
			{ name: "Go", logo: "go" },
			{ name: "Hono", logo: "hono" },
			{ name: "PostgreSQL", logo: "postgresql" },
			{ name: "Drizzle ORM", logo: "drizzle" },
		],
	},
	{
		title: "Infrastructure",
		note: "Global, cheap, reproducible.",
		items: [
			{ name: "Cloudflare", logo: "cloudflare" },
			{ name: "Cloudflare Workers", logo: "cloudflareworkers" },
			{ name: "GitHub Actions", logo: "githubactions" },
			{ name: "GitHub", logo: "github" },
		],
	},
	{
		title: "AI",
		note: "Models in production, not in demos.",
		items: [
			{ name: "Anthropic", logo: "anthropic" },
			{ name: "Claude", logo: "claude" },
			{ name: "Google Gemini", logo: "googlegemini" },
			{ name: "Hugging Face", logo: "huggingface" },
			{ name: "Ollama", logo: "ollama" },
			{ name: "LangChain", logo: "langchain" },
			{ name: "Mistral", logo: "mistralai" },
		],
	},
	{
		title: "Payments",
		note: "Checkout people actually finish.",
		items: [{ name: "Stripe", logo: "stripe" }],
	},
	{
		title: "Design",
		note: "Systems, not one-off screens.",
		items: [{ name: "Figma", logo: "figma" }],
	},
	{
		title: "Quality & observability",
		note: "Know when something breaks.",
		items: [
			{ name: "Zod", logo: "zod" },
			{ name: "Sentry", logo: "sentry" },
		],
	},
];
---

<PageLayout
	meta={{
		title: "Stack",
		description:
			"The tools Focus Lab builds with — Astro, Cloudflare, TypeScript, Postgres, and AI models in production.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Stack</p>
			<h1>The tools we build with.</h1>
			<p>
				We pick boring, proven technology and push it hard — a small typed core for everything that
				matters, and AI models where they earn their place.
			</p>
		</div>

		<div class="stack">
			{
				groups.map((group) => (
					<section class="stack__group">
						<h2>{group.title}</h2>
						<p class="stack__note">{group.note}</p>
						<ul class="stack__items">
							{group.items.map((item) => (
								<li
									class="stack__item"
									style={item.logo ? `--logo: url(/assets/stack/${item.logo}.svg)` : undefined}
								>
									{item.logo && <span class="stack__logo" aria-hidden="true" />}
									<span class="stack__name">{item.name}</span>
								</li>
							))}
						</ul>
					</section>
				))
			}
		</div>

		<div class="page__content content">
			<hr class="ornament" />

			<h2 id="choose">How we choose</h2>
			<ol class="numbered">
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">Boring beats novel.</h3>
						<p>
							Years of docs, real failure modes, and people who know them. Novelty is a cost, not a
							feature.
						</p>
					</div>
				</li>
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">Every layer earns its place.</h3>
						<p>
							If a dependency doesn't remove more work than it adds, we write the small version
							ourselves.
						</p>
					</div>
				</li>
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">We own the whole path.</h3>
						<p>
							From the first commit to the last deploy. That's the only way to keep it fast, cheap,
							and ours to fix.
						</p>
					</div>
				</li>
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">AI where it helps, not everywhere.</h3>
						<p>
							Models earn a place by removing real work. Anywhere else, a typed function is cheaper
							and more predictable.
						</p>
					</div>
				</li>
			</ol>

			<blockquote class="pull">
				<p>
					Choose boring technology. The excitement of the new thing lasts a release, and the
					debugging lasts the life of the product.
				</p>
				<cite>Focus Lab</cite>
			</blockquote>

			<div class="panel">
				<h3 class="panel__title">Something missing?</h3>
				<div class="panel__body">
					<p>
						The list above is what runs in production today, not an aspiration. If you think a tool
						belongs here, tell us what it would replace and why.
					</p>
				</div>
				<div class="panel__actions">
					<a class="button button--ghost" href={getNavLink("/contact/")}>Get in touch</a>
				</div>
			</div>
		</div>
	</div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";

const groups = [
	{
		title: "Frontend",
		note: "Fast by default, accessible always.",
		items: ["Astro", "React", "TypeScript", "Tailwind CSS", "Framer"],
	},
	{
		title: "Backend & data",
		note: "Small, typed services.",
		items: ["Node.js", "Hono", "PostgreSQL", "Cloudflare D1", "Durable Objects"],
	},
	{
		title: "Infrastructure",
		note: "Global, cheap, reproducible.",
		items: ["Cloudflare Workers", "Cloudflare R2", "Cloudflare KV", "GitHub Actions"],
	},
	{
		title: "Commerce & CMS",
		note: "Content and checkout that convert.",
		items: ["Shopify", "Stripe", "Framer", "Headless CMS"],
	},
	{
		title: "AI",
		note: "Models in production, not in demos.",
		items: ["OpenAI", "Anthropic", "Cloudflare Workers AI", "MCP"],
	},
	{
		title: "Design",
		note: "Systems, not one-off screens.",
		items: ["Figma", "Framer"],
	},
	{
		title: "Testing & quality",
		note: "Ship with confidence.",
		items: ["Vitest", "Playwright", "TypeScript", "GitHub Actions"],
	},
	{
		title: "Observability",
		note: "Know when something breaks.",
		items: ["Cloudflare Analytics", "Sentry", "Logpush"],
	},
	{
		title: "Payments & email",
		note: "The parts customers feel.",
		items: ["Stripe", "Shopify Payments", "Resend", "Cloudflare Email"],
	},
];
---

<PageLayout
	meta={{
		title: "Stack",
		description:
			"The tools Focus Lab builds with — Astro, Cloudflare, TypeScript, Stripe, and a small proven core around them.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Stack</p>
			<h1>The tools we build with.</h1>
			<p>
				We pick boring, proven technology and push it hard. Shopify, Cloudflare, and Framer for the
				edges — a small typed core for everything that matters.
			</p>
		</div>

		<div class="page__content content">
			{
				groups.map((group) => (
					<>
						<h2>{group.title}</h2>
						<p>{group.note}</p>
						<ul class="list-spaced">
							{group.items.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</>
				))
			}

			<hr class="ornament" />

			<h2>How we choose</h2>
			<p>
				We pick boring, proven tools. The ones with years of docs, real failure modes, and people
				who know them. Novelty is a cost, not a feature.
			</p>
			<p>
				Every layer has to earn its place. If a dependency does not remove more work than it adds,
				we write the small version ourselves.
			</p>
			<p>
				We own the whole path — from the first commit to the last deploy. That is the only way to
				keep it fast, cheap, and ours to fix.
			</p>
		</div>
	</div>
</PageLayout>

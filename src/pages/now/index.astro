---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";

const items = [
	{ label: "Building", value: "Workproof — a calm way for teams to show what they shipped." },
	{ label: "Shipping", value: "Muxo — one key for web, LLM, compute, and storage." },
	{ label: "Running", value: "Urbanevents — events, end to end, in Pakistan." },
	{ label: "Writing", value: "Notes on the boring stack and why we pick it." },
	{ label: "Reading", value: "Whatever keeps us honest about what customers actually need." },
	{ label: "Open to", value: "A couple of product partnerships this year." },
];
---

<PageLayout
	meta={{
		title: "Now",
		description: "What Focus Lab is working on right now.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h6>Now</h6>
			<h1>What we're working on.</h1>
			<p>A snapshot, not a roadmap. Last updated September 2026.</p>
		</div>

		<div class="page__content content">
			<dl class="now-list">
				{
					items.map((item) => (
						<div>
							<dt>{item.label}</dt>
							<dd>{item.value}</dd>
						</div>
					))
				}
			</dl>

			<hr class="ornament" />

			<p>
				Want to work on something together? <a href={getNavLink("/contact/")}>Get in touch</a>.
			</p>
		</div>
	</div>
</PageLayout>

<style>
	.now-list {
		display: flex;
		flex-direction: column;
		gap: 1.4em;
		margin: 0;
	}

	.now-list div {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
	}

	.now-list dt {
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.8em;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.now-list dd {
		margin: 0;
		color: var(--color-white);
		font-size: 1.05em;
	}
</style>

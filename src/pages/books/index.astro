---
import PageLayout from "@/layouts/Base.astro";

const books = [
	{
		title: "Inspired",
		author: "Marty Cagan",
		desc: "How the best product teams decide what to build and why. The clearest argument we know for putting product before process.",
		href: "https://www.svpg.com/inspired-how-to-create-products-customers-love/",
	},
	{
		title: "The Lean Startup",
		author: "Eric Ries",
		desc: "Build, measure, learn. The loop behind every product we ship — and the reason we keep scope small enough to test.",
		href: "https://theleanstartup.com/",
	},
	{
		title: "The Design of Everyday Things",
		author: "Don Norman",
		desc: "Why some interfaces feel obvious and others fight you. Required reading before we design anything.",
		href: "https://www.nngroup.com/books/design-everyday-things-revised/",
	},
	{
		title: "Refactoring UI",
		author: "Adam Wathan & Steve Schoger",
		desc: "Practical interface design for people who build. Tactics we reach for on every screen.",
		href: "https://www.refactoringui.com/",
	},
	{
		title: "Continuous Discovery Habits",
		author: "Teresa Torres",
		desc: "How to stay close to customers every week instead of every quarter. Keeps us honest about what people actually need.",
		href: "https://www.producttalk.org/continuous-discovery-habits/",
	},
];
---

<PageLayout
	meta={{
		title: "Books",
		description: "The books that shaped how Focus Lab builds products.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Books</p>
			<h1>Books that shaped how we build.</h1>
			<p>A short shelf. Every one of these changed how we work, not just what we know.</p>
		</div>

		<div class="page__content content">
			{
				books.map((book) => (
					<>
						<h2>
							<a href={book.href} target="_blank" rel="noopener">
								{book.title}
							</a>
						</h2>
						<p class="font-size-small">{book.author}</p>
						<p>{book.desc}</p>
					</>
				))
			}
		</div>
	</div>
</PageLayout>

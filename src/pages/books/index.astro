---
import PageLayout from "@/layouts/Base.astro";
import { books } from "@/data/books";
---

<PageLayout
	meta={{
		title: "Books",
		description: "The books that shaped how Focus Lab builds products.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h1>Books that shaped how we build.</h1>
			<p>
				On top of running our own products, we read about the craft. This is the short shelf that
				changed how we work — not just what we know.
			</p>
		</div>

		<div class="books">
			<div class="books__container">
				{
					books.map((book) => (
						<div class="books__book">
							<div class="books__wrap">
								<figure>
									<a
										href={book.links[0]?.href ?? "#"}
										target="_blank"
										rel="noopener"
										aria-label={book.title}
									>
										<span class="book-cover" style={`--book-tint: var(--rgb-theme-${book.tint})`}>
											<span class="book-cover__mark">{book.mark}</span>
											<span class="book-cover__title">{book.title}</span>
										</span>
									</a>
								</figure>

								<div class="books__content">
									<h3>{book.title}</h3>
									<p class="font-size-small">{book.author}</p>
									<p>{book.description}</p>
									<ul>
										{book.links.map((item) => (
											<li>
												<a href={item.href} target="_blank" rel="noopener">
													{item.label}
												</a>
											</li>
										))}
									</ul>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</PageLayout>

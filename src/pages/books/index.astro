---
import PageLayout from "@/layouts/Base.astro";
import { books } from "@/data/books";

const total = books.length;
---

<PageLayout
	meta={{
		title: "Books",
		description:
			"The 22 books that changed how Focus Lab builds and runs software, from Inspired to Shape Up to Zen and the Art of Motorcycle Maintenance.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Books</p>
			<h1>Books that shaped how we build.</h1>
			<p>
				On top of running our own products, we read about the craft. These {total} are the ones that
				changed how we work — not just what we know. Links go to the publisher or a free edition where
				one exists.
			</p>
		</div>

		<div class="books">
			<div class="books__container">
				{
					books.map((book) => (
						<div class="books__book">
							<div class="books__wrap">
								<figure>
									<a
										href={book.links[0]?.href ?? "#"}
										target="_blank"
										rel="noopener"
										aria-label={book.title}
									>
										<span
											class="book-cover"
											style={`--book-tint: var(--rgb-theme-${book.tint}); --book-ink: var(--rgb-book-ink-${book.tint}, var(--rgb-ink))`}
										>
											<span class="book-cover__mark">{book.mark}</span>
											<span class="book-cover__title">{book.title}</span>
										</span>
									</a>
								</figure>

								<div class="books__content">
									<h2>{book.title}</h2>
									<p class="font-size-small">{book.author}</p>
									<p>{book.description}</p>
									<ul>
										{book.links.map((item) => (
											<li>
												<a href={item.href} target="_blank" rel="noopener">
													{item.label}
												</a>
											</li>
										))}
									</ul>
								</div>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</PageLayout>

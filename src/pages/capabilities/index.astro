---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";

const capabilities: Array<{ id: string; title: string; body: string }> = [
	{
		id: "ai-product-engineering",
		title: "AI product engineering",
		body: "Models are easy now. Products aren't. We ship AI that survives real users — evals, latency budgets, guardrails, and an interface people trust.",
	},
	{
		id: "saas-platform-engineering",
		title: "SaaS platform engineering",
		body: "Multi-tenant, billed, permissioned, observable. The unglamorous parts decide whether a product survives year two. We do those properly.",
	},
	{
		id: "mobile-app-development",
		title: "Mobile app development",
		body: "One codebase, native feel. Offline, push, deep links, and store submission — finished when it's in someone's hand, not in a demo.",
	},
	{
		id: "web-app-development",
		title: "Web app development",
		body: "Fast, accessible, and built to outlast the team that wrote it. Performance budgets over promises.",
	},
	{
		id: "ecommerce-engineering",
		title: "Ecommerce engineering",
		body: "Faster storefronts convert better, and most of the win is removing weight — not adding features. Like warp-n-woof.com.",
	},
	{
		id: "framer-cms-sites",
		title: "Framer & CMS sites",
		body: "Sites your team edits without breaking the design. Real components, real performance, no ticket to change a headline.",
	},
];

const nextHref = getNavLink("/stack/");
const previousHref = getNavLink("/work/");
---

<PageLayout
	meta={{
		title: "Capabilities",
		description:
			"Focus Lab is a product company. We design, build, and operate AI products, SaaS platforms, mobile apps, and ecommerce — and we're open to contract work.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h6>Capabilities</h6>
			<h1>We build our own products.<br /> We'll build yours, too.</h1>
			<p>
				Everything we know comes from shipping and running software we own. We take on a small
				number of contract builds each year.
			</p>
		</div>

		<div class="page__content content">
			{capabilities.map((capability) => (
				<section id={capability.id}>
					<h2>{capability.title}</h2>
					<p>{capability.body}</p>
				</section>
			))}

			<hr class="ornament" />

			<section id="open-to-contract">
				<h2>Open to contract</h2>
				<p>
					Most engagements start with a short, paid discovery: a working slice, a fixed scope, a
					clear number. No decks. No retainers we can't justify.
				</p>
				<a class="button" href={getNavLink("/contact/")}>
					Start a project <span>&rarr;</span>
				</a>
			</section>
		</div>
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
	>
		<a href={nextHref} aria-label="Next: Stack" tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>
---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";

const capabilities: Array<{ id: string; title: string; body: string }> = [
	{
		id: "ai-product-engineering",
		title: "AI product engineering",
		body: "Model selection, evaluation, latency and cost budgets, guardrails, and the interface that makes it feel obvious. Shipped, not demoed.",
	},
	{
		id: "saas-platform-engineering",
		title: "SaaS platform engineering",
		body: "Multi-tenant platforms, billing, permissions, and dashboards — the unglamorous parts that decide whether a product survives year two.",
	},
	{
		id: "mobile-app-development",
		title: "Mobile app development",
		body: "Native-feeling iOS and Android with one maintainable codebase. Offline, push, deep links, and store submission done properly.",
	},
	{
		id: "web-app-development",
		title: "Web app development",
		body: "Fast, accessible applications built to survive years of iteration and a growing team.",
	},
	{
		id: "ecommerce-engineering",
		title: "Ecommerce engineering",
		body: "Shopify storefronts engineered for speed, usability, and conversion — like warp-n-woof.com.",
	},
	{
		id: "framer-cms-sites",
		title: "Framer & CMS sites",
		body: "Marketing sites your team can edit without breaking the design. Real component systems, real performance.",
	},
];

const nextHref = getNavLink("/stack/");
const previousHref = getNavLink("/work/");
---

<PageLayout
	meta={{
		title: "Capabilities",
		description:
			"Focus Lab is a product company. We design, build, and operate AI products, SaaS platforms, mobile apps, and ecommerce — and we're open to contract work.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h6>Capabilities</h6>
			<h1>We build our own products.<br /> We'll build yours, too.</h1>
			<p>
				Everything we know comes from shipping and operating software we own. We take on a small
				number of contract builds each year.
			</p>
		</div>

		<div class="page__content content">
			{capabilities.map((capability) => (
				<section id={capability.id}>
					<h2>{capability.title}</h2>
					<p>{capability.body}</p>
				</section>
			))}

			<hr class="ornament" />

			<section id="open-to-contract">
				<h2>Open to contract</h2>
				<p>
					Most engagements start with a short, paid discovery: a working slice, a fixed scope, and
					a clear number. No decks, no retainers we can't justify.
				</p>
				<a class="button" href={getNavLink("/contact/")}>
					Start a project <span>&rarr;</span>
				</a>
			</section>
		</div>
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
	>
		<a href={nextHref} aria-label="Next: Stack" tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>
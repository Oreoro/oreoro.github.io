---
import PageLayout from "@/layouts/Base.astro";
import { capabilities } from "@/data/focuslab";
import { getNavLink } from "@/lib/blog-helpers";

const nextHref = getNavLink("/stack/");
const previousHref = getNavLink("/work/");
---

<PageLayout
	meta={{
		title: "Capabilities",
		description:
			"Focus Lab is a product company. We design, build, and operate AI products, SaaS platforms, mobile apps, and ecommerce — and we're open to contract work.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h6>Capabilities</h6>
			<h1>We build our own products.<br /> We'll build yours, too.</h1>
			<p>
				Everything we know comes from shipping and running software we own. We take on a small
				number of contract builds each year.
			</p>
		</div>

		<div class="page__content content">
			{capabilities.map((capability) => (
				<section id={capability.id} class="capability">
					<h2>{capability.title}</h2>
					<p>{capability.body}</p>
					<ul class="capability__points">
						{capability.points.map((point) => (
							<li>{point}</li>
						))}
					</ul>
				</section>
			))}

			<hr class="ornament" />

			<section id="open-to-contract">
				<h2>Open to contract</h2>
				<p>
					Most engagements start with a short, paid discovery: a working slice, a fixed scope, a
					clear number. No decks. No retainers we can't justify.
				</p>
				<a class="button" href={getNavLink("/contact/")}>
					Start a project <span>&rarr;</span>
				</a>
			</section>
		</div>
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
	>
		<a href={nextHref} aria-label="Next: Stack" tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>

<style>
	.capability {
		margin-bottom: 2.4em;
	}

	.capability:last-of-type {
		margin-bottom: 0;
	}

	.capability__points {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(11em, 1fr));
		gap: 0.5em 1em;
		margin: 0.9em 0 0;
		padding: 0;
		list-style: none;
	}

	.capability__points li {
		position: relative;
		padding-left: 1.1em;
		color: rgba(255, 255, 255, 0.8);
		font-size: 0.92em;
		line-height: 1.45;
	}

	.capability__points li::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.55em;
		width: 0.45em;
		height: 0.45em;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.6);
	}
</style>
---
import PageLayout from "@/layouts/Base.astro";
import { products } from "@/data/focuslab";
import { getNavLink } from "@/lib/blog-helpers";
import "@/styles/work.css";

const nextHref = products[0] ? getNavLink(`/work/${products[0].slug}/`) : getNavLink("/");
const previousHref = products.length
	? getNavLink(`/work/${products[products.length - 1].slug}/`)
	: getNavLink("/");
---

<PageLayout
	meta={{
		title: "Work",
		description:
			"Products and platforms built and operated by Focus Lab — AI, SaaS, mobile, ecommerce, and Framer.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h6>Work</h6>
			<h1>Products and platforms we've shipped.</h1>
			<p>
				We don't hand over decks. We build, launch, and run real products — ours and a few
				partners'. Here's the work.
			</p>
		</div>

		<div class="page__content">
			<div class="work-grid">
				{products.map((product, index) => (
					<a
						class="work-card"
						href={getNavLink(`/work/${product.slug}/`)}
						style={`--work-index:${index}`}
					>
						<div class="work-card__media">
							{product.image ? (
								<img
									src={product.image}
									alt={`${product.name} preview`}
									loading="lazy"
									decoding="async"
								/>
							) : (
								<span class="work-card__placeholder">
									{product.name
										.split(/\s+/)
										.slice(0, 2)
										.map((word) => word.charAt(0))
										.join("")}
								</span>
							)}
						</div>
						<div class="work-card__body">
							<div class="work-card__meta">
								<span>{String(index + 1).padStart(2, "0")}</span>
								<span>{product.tags.slice(0, 2).join(" · ")}</span>
							</div>
							<h2 class="work-card__title">{product.name}</h2>
							<p class="work-card__desc">{product.tagline}</p>
						</div>
					</a>
				))}
			</div>

			<div class="cta-panel" style="margin-top: calc(var(--line-height) * 2)">
				<p>Have something to build? We're open to contract work.</p>
				<a class="button button--theme" href={getNavLink("/contact/")}>
					Start a project <span>&rarr;</span>
				</a>
			</div>
		</div>
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
	>
		<a href={nextHref} aria-label="Next product" tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>
---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";

const cases = [
	{
		title: "A faster Shopify storefront",
		client: "A direct-to-consumer apparel brand",
		problem:
			"The store had grown one app at a time. It was slow, the theme fought every change, and conversion had gone flat.",
		approach:
			"We rebuilt the theme around speed, deleted the scripts that didn't earn their bytes, and made Core Web Vitals a budget tracked on every deploy.",
		outcome:
			"Load time roughly halved and conversion moved up. The team can now change a page without a developer.",
		stack: ["Shopify", "Cloudflare", "TypeScript", "Liquid"],
	},
	{
		title: "An events platform, multi-tenant",
		client: "A ticketing startup",
		problem:
			"Every event was a one-off. There was no organizer tooling, no repeatable bookings, and no way to scale past a spreadsheet.",
		approach:
			"We built a multi-tenant core with discovery, bookings, QR check-in, organizer dashboards, and payouts — designed to run events, not to demo.",
		outcome:
			"Organizers onboard themselves and run events end to end. The platform carries the load on the night.",
		stack: ["Astro", "Node.js", "PostgreSQL", "Stripe", "Cloudflare"],
	},
	{
		title: "An AI feature people trust",
		client: "A SaaS team",
		problem:
			"The prototype impressed everyone and broke in production. Latency spiked, costs were unpredictable, and answers were inconsistent.",
		approach:
			"We started with the eval, not the model. Then we added latency and cost budgets, guardrails, fallbacks, and a human-in-the-loop review step.",
		outcome:
			"The feature shipped, stayed inside budget, and became part of the daily workflow instead of a demo.",
		stack: ["TypeScript", "Cloudflare Workers", "OpenAI", "Anthropic"],
	},
];
---

<PageLayout
	meta={{
		title: "Work",
		description:
			"Selected Focus Lab work — storefronts, platforms, and AI features built to run, not to demo.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h6>Work</h6>
			<h1>Products we've built.</h1>
			<p>
				A few of the things we've designed, built, and run. Names are held back, the work isn't.
			</p>
		</div>

		<div class="page__content content">
			{
				cases.map((item) => (
					<>
						<h2>{item.title}</h2>
						<p class="font-size-small">{item.client}</p>
						<h3>The problem</h3>
						<p>{item.problem}</p>
						<h3>What we did</h3>
						<p>{item.approach}</p>
						<h3>The outcome</h3>
						<p>{item.outcome}</p>
						<p class="font-size-small">{item.stack.join(" · ")}</p>
						<hr class="ornament" />
					</>
				))
			}

			<h2>Have a product in mind?</h2>
			<p>
				Tell us what you're building and what done looks like. We'll reply with a straight answer.
			</p>
			<p>
				<a class="button button--theme" href={getNavLink("/contact/")}>
					Start a conversation <span>&rarr;</span>
				</a>
			</p>
		</div>
	</div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
import Blocks from "@/components/blocks/Blocks.astro";
import { products } from "@/data/focuslab";
import { getNavLink } from "@/lib/blog-helpers";

export function getStaticPaths() {
	return products.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

const { product } = Astro.props;

const index = products.findIndex((item) => item.slug === product.slug);
const nextProduct = products[(index + 1) % products.length]!;
const previousProduct = products[(index - 1 + products.length) % products.length]!;
const nextHref = getNavLink(`/work/${nextProduct.slug}/`);
const previousHref = getNavLink(`/work/${previousProduct.slug}/`);
---

<PageLayout
	meta={{
		title: product.name,
		description: product.summary,
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h6>{product.tags.join(" · ")}</h6>
			<h1>{product.name}</h1>
			<p>{product.summary}</p>
			<div style="display:flex;flex-wrap:wrap;gap:0.5em;margin-top:0.6em">
				{
					product.link && (
						<a class="button" href={product.link} target="_blank" rel="noopener">
							Visit site <span>&rarr;</span>
						</a>
					)
				}
				<a class="button button--theme" href={getNavLink("/contact/")}>
					Start a project <span>&rarr;</span>
				</a>
			</div>
		</div>

		<div class="page__content content">
			{
				product.image && (
					<figure class="product-hero">
						<img src={product.image} alt={`${product.name} screenshot`} loading="eager" />
					</figure>
				)
			}
			<Blocks blocks={product.story} />
		</div>
	</div>

	<div class="boundary"></div>

	<div
		class="controller controller--origin"
		data-next={nextHref}
		data-previous={previousHref}
		role="navigation"
	>
		<a href={nextHref} aria-label="Next product" tabindex="-1"></a>
	</div>

	<div class="origin"></div>
</PageLayout>

<style>
	.product-hero {
		margin: 0 0 1.6em;
	}

	.product-hero img {
		width: 100%;
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 0.5em;
	}
</style>

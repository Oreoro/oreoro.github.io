---
import PageLayout from "@/layouts/Base.astro";
import Arrow from "@/components/ui/Arrow.astro";
import PageAnchors from "@/components/layout/PageAnchors.astro";
import { getNavLink } from "@/lib/blog-helpers";
import { policyLinks } from "@/data/policies";
import { site } from "@/data/focuslab";
---

<PageLayout
	meta={{
		title: "Policies",
		description:
			"Focus Lab's policies — terms, privacy, security, accessibility, refunds and ownership — written in plain language.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Policies</p>
			<h1>Short, clear, and readable.</h1>
			<p>
				Focus Lab makes our policies as clear, fair, and readable as possible. If one of these reads
				like legal boilerplate, that's our mistake — tell us.
			</p>
			<PageAnchors
				anchors={[
					{ id: "read", label: "Read these" },
					{ id: "approach", label: "How we treat these" },
				]}
			/>
		</div>

		<div class="page__body">
			<div class="page__content content content--policies">
				<h2 id="read">Read these</h2>
				<ul class="policy-list">
					{
						policyLinks.map((policy) => (
							<li>
								<a href={getNavLink(policy.href)}>{policy.label}</a>
							</li>
						))
					}
				</ul>

				<h2 id="approach">How we treat these</h2>
				<ol class="numbered">
					<li>
						<div class="numbered__body">
							<h3 class="numbered__title">Written to be read.</h3>
							<p>
								Plain language, short sentences, and no clauses hidden in the footnotes. If a policy
								needs a lawyer to understand, we've written it wrong.
							</p>
						</div>
					</li>
					<li>
						<div class="numbered__body">
							<h3 class="numbered__title">Changed only when something changes.</h3>
							<p>
								We update these to comply with the law and to reflect how we actually work. We don't
								reshuffle the wording just to look current.
							</p>
						</div>
					</li>
					<li>
						<div class="numbered__body">
							<h3 class="numbered__title">Request updates by email.</h3>
							<p>
								If you'd like to hear about policy changes, <a
									href={getNavLink("/policies/updates")}>request policy updates by email</a
								>. You'll prepare a draft and send it from your email app; there is no automatic
								subscription on this site.
							</p>
						</div>
					</li>
				</ol>

				<div class="panel">
					<h3 class="panel__title">Something unclear?</h3>
					<div class="panel__body">
						<p>
							Ask. Write to <a href={`mailto:${site.email}`}>{site.email}</a> and we'll explain it in
							a sentence, or fix the page so nobody has to ask.
						</p>
					</div>
					<div class="panel__actions">
						<a class="button" href={`mailto:${site.email}`}>Email us <Arrow /></a>
						<a class="button button--ghost" href={getNavLink("/contact/")}>Contact</a>
					</div>
				</div>
			</div>
		</div>
	</div>
</PageLayout>

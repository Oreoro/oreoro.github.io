---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";
import { policies } from "@/data/policies";

const readable = policies.filter((policy) => policy.slug !== "updates");
---

<PageLayout
	meta={{
		title: "Policies",
		description:
			"Focus Lab's policies — terms, privacy, security, accessibility, refunds and ownership — written in plain language.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Policies</p>
			<h1>Short, clear, and readable.</h1>
			<p>
				If one of these reads like legal boilerplate, that's our mistake — tell us.
			</p>
		</div>

		<div class="page__body">
			<div class="page__content content content--policies">
				<table class="ledger">
					<tbody>
						{
							readable.map((policy) => (
								<tr>
									<th scope="row">
										<a href={getNavLink(`/policies/${policy.slug}`)}>{policy.title}</a>
									</th>
									<td>{policy.blurb ?? policy.intro}</td>
								</tr>
							))
						}
					</tbody>
				</table>

				<p>
					To hear about changes, <a
						href={getNavLink("/policies/updates")}>request policy updates by email</a
					>.
				</p>
			</div>
		</div>
	</div>
</PageLayout>

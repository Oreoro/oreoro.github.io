---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";
import { policyLinks } from "@/data/policies";
---

<PageLayout
	meta={{
		title: "Policies",
		description: "Our policies.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h1>Policies</h1>
			<p>Focus Lab makes our policies as clear, fair, and readable as possible.</p>
		</div>

		<div class="page__body">
			<div class="page__content content content--policies">
				<ul>
					{
						policyLinks.map((policy) => (
							<li>
								<a href={getNavLink(policy.href)}>{policy.label}</a>
							</li>
						))
					}
				</ul>
				<hr />
				<p>
					Focus Lab may update these policies as needed to comply with relevant regulations and
					reflect any new practices. If we make significant changes, we will refresh the date at the
					top of the page and notify users who have signed up to our <a
						href={getNavLink("/policies/updates")}>policy updates mailing list</a
					>.
				</p>
			</div>
		</div>
	</div>
</PageLayout>

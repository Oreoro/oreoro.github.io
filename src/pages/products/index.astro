---
import PageLayout from "@/layouts/Base.astro";
import ProductCard from "@/components/ui/ProductCard.astro";
import { products } from "@/data/products";
---

<PageLayout
	meta={{
		title: "Products",
		description:
			"Software Focus Lab designs, builds, and runs: Urban Events, WorkProof, and Fixer.",
	}}
>
	<div class="page page--wide">
		<div class="page__headline">
			<p class="page__kicker">Products</p>
			<h1>Software we build and run.</h1>
			<p>
				We design, ship, and operate our own products — and carry the pager for them. Two run in the
				open, and one runs on your infrastructure.
			</p>
		</div>

		<div class="product-cards">
			{products.map((product, index) => <ProductCard product={product} index={index} />)}
		</div>
	</div>
</PageLayout>

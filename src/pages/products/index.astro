---
import PageLayout from "@/layouts/Base.astro";
import ProductCard from "@/components/ui/ProductCard.astro";
import { products } from "@/data/products";
---

<PageLayout
	meta={{
		title: "Products",
		description:
			"Software Focus Lab designs, builds, and runs: Urban Events, WorkProof, and Fixer.",
	}}
>
	<div class="page page--wide">
		<div class="page__headline">
			<p class="page__kicker">Products</p>
			<h1>Software we build and run.</h1>
			<p>
				Our own products, built and run in Islamabad. Each link opens the product's
				own website directly.
			</p>
		</div>

		<div class="product-cards">
			{products.map((product) => <ProductCard product={product} />)}
		</div>
	</div>
</PageLayout>

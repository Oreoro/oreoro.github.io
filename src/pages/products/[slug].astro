---
import PageLayout from "@/layouts/Base.astro";
import { products } from "@/data/products";
import { getNavLink } from "@/lib/blog-helpers";
import { site } from "@/data/focuslab";

export function getStaticPaths() {
	return products.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

const { product } = Astro.props;
---

<PageLayout
	meta={{
		title: product.name,
		description: product.summary,
		jsonLd: {
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			name: product.name,
			description: product.summary,
			url: product.url ?? Astro.url.href,
			applicationCategory: "BusinessApplication",
			operatingSystem: product.selfHosted ? "Self-hosted" : "Web",
			brand: { "@type": "Organization", name: "Focus Lab" },
		},
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Product</p>
			<h1>{product.name}</h1>
			<p>{product.tagline}</p>
		</div>

		<div class="page__content content">
			<p>{product.summary}</p>

			{
				product.pricing && (
					<p class="font-size-small">
						<em>{product.pricing}</em>
					</p>
				)
			}

			{
				product.url ? (
					<p>
						<a class="button button--theme" href={product.url} target="_blank" rel="noopener">
							Visit {product.name} <span>&rarr;</span>
						</a>
					</p>
				) : (
					<p>
						<a
							class="button button--theme"
							href={`mailto:${site.email}?subject=${encodeURIComponent(`Access to ${product.name}`)}`}
						>
							Request access or a demo <span>&rarr;</span>
						</a>
					</p>
				)
			}

			<h2>What it does</h2>
			{
				product.features.map((feature) => (
					<>
						<h3>{feature.title}</h3>
						<p>{feature.body}</p>
					</>
				))
			}

			{
				product.stack && product.stack.length > 0 && (
					<>
						<h2>Built with</h2>
						<ul class="list-spaced">
							{product.stack.map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</>
				)
			}

			<hr class="ornament" />

			<p>
				Building something similar? <a href={getNavLink("/contact/")}>Start a conversation</a>.
			</p>
		</div>
	</div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
import Arrow from "@/components/ui/Arrow.astro";
import { products } from "@/data/products";
import { getNavLink } from "@/lib/blog-helpers";
import { site } from "@/data/focuslab";

export function getStaticPaths() {
	return products.map((product) => ({
		params: { slug: product.slug },
		props: { product },
	}));
}

const { product } = Astro.props;
const others = products.filter((item) => item.slug !== product.slug);
const accessHref = `mailto:${site.email}?subject=${encodeURIComponent(`Access to ${product.name}`)}`;
const siteOrigin = Astro.site?.origin ?? Astro.url.origin;
---

<PageLayout
	meta={{
		title: product.name,
		// The blurb, not the summary: the summary is written for a reader who
		// is already on the page and is too long to survive a search result.
		description: product.blurb,
		jsonLd: {
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			name: product.name,
			description: product.blurb,
			url: product.url ?? Astro.url.href,
			applicationCategory: "BusinessApplication",
			operatingSystem: product.selfHosted ? "Self-hosted" : "Web",
			publisher: { "@id": `${siteOrigin}/#organization` },
			brand: { "@id": `${siteOrigin}/#organization` },
		},
	}}
>
	<div class="page page--wide product">
		<header class="product__hero">
			<p class="product__breadcrumb"><a href={getNavLink("/products/")}>← All products</a></p>
			<p class="product__kicker">
				Product{product.selfHosted ? " · Self-hosted" : ""}
			</p>
			<h1>{product.name}</h1>
			<p class="product__tagline">{product.tagline}</p>
			<p class="product__summary">{product.summary}</p>
			{product.pricing && <p class="product__pricing">{product.pricing}</p>}

			<div class="product__actions">
				{
					product.url ? (
						<a class="button" href={product.url} target="_blank" rel="noopener">
							Visit {product.name} <Arrow direction="external" />
						</a>
					) : (
						<a class="button" href={accessHref}>
							Request access or a demo <Arrow />
						</a>
					)
				}
				<a class="button button--ghost" href={getNavLink("/contact/")}>Talk to us</a>
			</div>
		</header>

		<section class="product__section">
			<h2>What it does</h2>
			<div class="product__grid">
				{
					product.features.map((feature) => (
						<article class="product__feature">
							<h3>{feature.title}</h3>
							<p>{feature.body}</p>
						</article>
					))
				}
			</div>
		</section>

		{
			product.notFor.length > 0 && (
				<section class="product__section">
					<h2>What it is not</h2>
					<p class="product__section-note">
						Most enquiries we turn away are one of these three. If yours is, we will say so in the
						first reply rather than the third.
					</p>
					<ul class="product__not">
						{product.notFor.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>
			)
		}

		{
			product.stack && product.stack.length > 0 && (
				<section class="product__section">
					<h2>Built with</h2>
					<ul class="list-spaced">
						{product.stack.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				</section>
			)
		}

		<hr class="ornament" />

		<section class="product__section">
			<h2>More from Focus Lab</h2>
			<ul class="product__nav">
				{
					others.map((item) => (
						<li>
							<a href={getNavLink(`/products/${item.slug}/`)}>{item.name}</a>
							{" — "}
							{item.tagline}
						</li>
					))
				}
			</ul>
		</section>
	</div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";
---

<PageLayout
	meta={{
		title: "Jobs",
		description: "Work at Focus Lab.",
		ogImage: "/og-image/home.png",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h1>Jobs</h1>
			<p>Placeholder intro. Replace with your own copy.</p>
		</div>

		<div class="jobs">
			<div class="jobs__container">
				<div class="jobs__job">
					<p><em>No open positions right now. Placeholder.</em></p>
				</div>
			</div>

			<div class="signup signup--mc signup--jobs content">
				<h5>Get notified</h5>
				<p>Placeholder copy. Replace with your own. <a href={getNavLink("/jobs/")}>Jobs feed</a>.</p>
				<form novalidate action="#" method="post" id="mc-embedded-subscribe-form" name="mc-embedded-subscribe-form" target="_self">
					<div aria-hidden="true" style="position: absolute; left: -5000px;">
						<input type="text" name="b_honeypot" tabindex="-1" value="" />
					</div>
					<input
						type="email"
						placeholder="you@example.com"
						spellcheck="false"
						value=""
						name="EMAIL"
						id="mce-EMAIL"
					/>
					<button class="button button--theme" type="submit" name="subscribe" id="mc-embedded-subscribe">
						Subscribe
					</button>
				</form>
			</div>

			<div class="jobs__content content content--jobs">
				<h2>How we work</h2>
				<p class="font-size-xx-large">Placeholder heading. Replace with your own copy.</p>
				<p>Placeholder paragraph. Replace with your own copy.</p>
				<p>Placeholder paragraph with <strong>emphasis</strong>. Replace with your own copy.</p>

				<h2>Benefits</h2>
				<p class="font-size-xx-large">Placeholder heading. Replace with your own copy.</p>
				<p>Placeholder paragraph. Replace with your own copy.</p>

				<h2>The hiring process</h2>
				<p class="font-size-xx-large">Placeholder heading. Replace with your own copy.</p>
				<p>Placeholder paragraph. Replace with your own copy.</p>
			</div>
		</div>
	</div>
</PageLayout>
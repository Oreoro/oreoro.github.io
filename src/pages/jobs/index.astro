---
import PageLayout from "@/layouts/Base.astro";
import EmailRequest from "@/components/ui/EmailRequest.astro";
import { getNavLink } from "@/lib/blog-helpers";
import { site } from "@/data/focuslab";
---

<PageLayout
	meta={{
		title: "Jobs",
		description:
			"Working at Focus Lab, a small independent product studio in Islamabad. No open positions right now — get notified by email when that changes.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Jobs</p>
			<h1>Working at Focus Lab</h1>
			<p>No open positions right now — leave your email to hear when that changes.</p>
		</div>

		<div class="jobs">
			<div class="signup signup--jobs content">
				<h2>Job notifications</h2>
				<p>
					Hear about openings by email below, or <a
						href={getNavLink("/feed/jobs.xml")}>grab the RSS feed</a
					>. We never share your email.
				</p>
				<EmailRequest
					id="job-notifications"
					recipient={site.email}
					subject="Focus Lab jobs"
					request="I'd like to receive email notifications about Focus Lab job openings."
					hint="This prepares a draft in your email app. You must open and send it to request job notifications; this form does not subscribe you automatically."
				/>
			</div>
		</div>
	</div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
import { thoughts } from "@/data/thoughts";
---

<PageLayout
	meta={{
		title: "Thoughts",
		description:
			"Writing we find useful — a curated list of essays and guides that shaped how Focus Lab builds.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h1>Writing we find useful</h1>
			<p>
				A running list of essays and guides that shaped how we build and run products. Every link
				goes to the original author — none of this is ours.
			</p>
		</div>

		<div class="thoughts">
			<div class="thoughts__container">
				{
					thoughts.map((thought) => (
						<div class="thoughts__thought">
							<h3>
								<a href={thought.url} target="_blank" rel="noopener">
									{thought.title}
								</a>
							</h3>
							<p class="font-size-small">{thought.source}</p>
							<p>{thought.note}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</PageLayout>

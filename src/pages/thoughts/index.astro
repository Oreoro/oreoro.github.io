---
import PageLayout from "@/layouts/Base.astro";
import { getNavLink } from "@/lib/blog-helpers";
import { thoughts } from "@/data/thoughts";
---

<PageLayout
	meta={{
		title: "Thoughts",
		description: "Longer notes on how we build and run products.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<h1>Thoughts</h1>
			<p>Longer notes on how we build and run products.</p>
		</div>

		<div class="thoughts">
			<div class="thoughts__container">
				{
					thoughts.map((thought) => (
						<div class="thoughts__thought">
							<h2>
								<a href={getNavLink(`/thoughts/${thought.slug}/`)}>{thought.title}</a>
							</h2>
							<p>{thought.intro}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
import { thoughts } from "@/data/thoughts";

export function getStaticPaths() {
	return thoughts.map((thought) => ({
		params: { slug: thought.slug },
		props: { thought },
	}));
}

const { thought } = Astro.props;
---

<PageLayout
	meta={{
		title: thought.title,
		description: thought.intro,
		jsonLd: {
			"@context": "https://schema.org",
			"@type": "Article",
			headline: thought.title,
			description: thought.intro,
			url: Astro.url.href,
			author: { "@type": "Organization", name: "Focus Lab" },
			publisher: { "@type": "Organization", name: "Focus Lab" },
		},
	}}
>
	<div class="page">
		<div class="page__headline">
			<h1>{thought.title}</h1>
			<p>{thought.intro}</p>
		</div>

		<div class="thought">
			<div class="thought__content content content--thoughts">
				{
					thought.sections.map((section) => (
						<>
							<h2 id={section.id}>{section.heading}</h2>
							{section.body.map((paragraph) => (
								<p>{paragraph}</p>
							))}
						</>
					))
				}
			</div>
		</div>
	</div>
</PageLayout>

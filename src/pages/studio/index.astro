---
import PageLayout from "@/layouts/Base.astro";
import Arrow from "@/components/ui/Arrow.astro";
import PageAnchors from "@/components/layout/PageAnchors.astro";
import { products } from "@/data/products";
import { getNavLink } from "@/lib/blog-helpers";
import { site } from "@/data/focuslab";
---

<PageLayout
	meta={{
		title: "Studio",
		description:
			"Focus Lab is a product studio in Islamabad. We build and run our own software.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Studio</p>
			<h1>We build products.</h1>
			<p>
				Focus Lab is a product studio in Islamabad. We design, build, and run our own software.
			</p>
			<PageAnchors
				anchors={[
					{ id: "believe", label: "What we believe" },
					{ id: "built", label: "What we've built" },
					{ id: "working", label: "Working with us" },
				]}
			/>
		</div>

		<div class="page__content content">
			<h2 id="believe">What we believe</h2>
			<ol class="numbered">
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">Product first.</h3>
						<p>
							Start with the smallest thing worth building, and put it in front of a real person as
							early as you can.
						</p>
					</div>
				</li>
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">Ship to learn.</h3>
						<p>
							Working software tells the truth. A guess costs more the longer you hold it.
						</p>
					</div>
				</li>
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">Small on purpose.</h3>
						<p>Small teams move faster and decide better.</p>
					</div>
				</li>
				<li>
					<div class="numbered__body">
						<h3 class="numbered__title">Own the outcome.</h3>
						<p>
							Stay for support, metrics, and the second year. Handing a product over at launch is
							not running a product.
						</p>
					</div>
				</li>
			</ol>

			<h2 id="built">What we've built</h2>
			<table class="ledger">
				<tbody>
					{
						products.map((product) => (
							<tr>
								<th scope="row">
									<a href={product.url} target="_blank" rel="noopener">
										{product.name}
									</a>
								</th>
								<td>{product.tagline}</td>
							</tr>
						))
					}
				</tbody>
			</table>

			<blockquote class="pull">
				<p>Small enough to still answer the phone in year three.</p>
				<cite>Focus Lab</cite>
			</blockquote>

			<h2 id="working">Working with us</h2>
			<p>
				Partner work only when there is a mutual fit: a real problem, a clear owner, and room to
				decide. If we are not the right fit, we say so early.
			</p>

			<div class="panel">
				<h3 class="panel__title">Start a conversation</h3>
				<div class="panel__body">
					<p>Tell us what you're building and what done looks like.</p>
					<p>
						Email <a href={`mailto:${site.email}`}>{site.email}</a>, or reach us on <a
							href="https://www.linkedin.com/company/110646093/"
							target="_blank"
							rel="noopener">LinkedIn</a
						>.
					</p>
				</div>
				<div class="panel__actions">
					<a class="button" href={`mailto:${site.email}`}>Email us <Arrow /></a>
					<a class="button button--ghost" href={getNavLink("/contact/")}>Contact</a>
				</div>
			</div>
		</div>
	</div>
</PageLayout>

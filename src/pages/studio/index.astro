---
import PageLayout from "@/layouts/Base.astro";
import { products } from "@/data/products";
import { getNavLink } from "@/lib/blog-helpers";
---

<PageLayout
	meta={{
		title: "Studio",
		description:
			"Focus Lab is a product studio in Islamabad. We design, build, and run our own software — and occasionally partner with a team when the fit is right.",
	}}
>
	<div class="page">
		<div class="page__headline">
			<p class="page__kicker">Studio</p>
			<h1>We build products.<br /> That is the work.</h1>
			<p>
				Focus Lab is a product studio based in Islamabad. We design, build, and run our own
				software. Once in a while, when there is a mutual fit, we partner with a team on theirs.
			</p>
		</div>

		<div class="page__content content">
			<h2>What we believe</h2>
			<ul class="list-spaced">
				<li>
					<strong>Product first.</strong> We don't start with a deck. We start with the smallest thing
					worth building.
				</li>
				<li>
					<strong>Ship to learn.</strong> Working software tells the truth. Everything else is a guess.
				</li>
				<li>
					<strong>Small on purpose.</strong> Small teams move faster, decide better, and stay accountable.
				</li>
				<li>
					<strong>Own the outcome.</strong> We stay for support, metrics, and the second year.
				</li>
			</ul>

			<h2>What we've built</h2>
			<ul class="list-spaced">
				{
					products.map((product) => (
						<li>
							{product.url ? (
								<a href={product.url} target="_blank" rel="noopener">
									{product.name}
								</a>
							) : (
								<a href={getNavLink(`/products/${product.slug}/`)}>{product.name}</a>
							)}{" "}
							— {product.tagline}
						</li>
					))
				}
			</ul>

			<hr class="ornament" />

			<h2>Working with us</h2>
			<p>
				We are products first. We take on partner work only when there is a mutual fit: a real
				problem, a clear owner, and room to decide how to solve it. If we are not the right fit, we
				will say so early.
			</p>
			<p>
				<a class="button button--theme" href={getNavLink("/contact/")}>
					Start a conversation <span>&rarr;</span>
				</a>
			</p>
		</div>
	</div>
</PageLayout>

---
import PageLayout from "@/layouts/Base.astro";
import { podcasts } from "@/data/podcast";
import PodcastSidebar from "@/components/podcast/PodcastSidebar.astro";

const bars = Array.from({ length: 96 }, (_, i) => {
	const wave = Math.sin(i * 0.6) * 0.5 + 0.5;
	const jitter = ((i * 37) % 11) / 22;
	return Math.round(8 + (wave + jitter) * 84);
});
---

<PageLayout
	meta={{
		title: "Podcast",
		description:
			"Podcasts we find useful — shows on building, shipping, and running software at a small studio.",
	}}
>
	<div class="broadsheet">
		<PodcastSidebar />

		<section class="broadsheet__content" aria-label="Podcasts">
			<div class="waveform" aria-hidden="true">
				{bars.map((height) => <div style={`height:${height}%`} />)}
			</div>

			<div class="broadsheet__episodes">
				{
					podcasts.map((podcast, index) => {
						const featured = index === 0;
						return (
							<article class={`episode${featured ? " --featured" : ""}`}>
								{featured && (
									<p class="episode__preface">
										<span>Start here</span>
									</p>
								)}
								<div class="episode__mast">
									{featured && (
										<a
											class="episode__play"
											href={podcast.url}
											target="_blank"
											rel="noopener"
											aria-label={`Listen to ${podcast.title}`}
										/>
									)}
									<small class="episode__number">{podcast.show}</small>
									<h2 class="episode__title">
										<a href={podcast.url} target="_blank" rel="noopener">
											{podcast.title}
										</a>
									</h2>
									<p class="episode__summary">{podcast.note}</p>
									<p class="episode__permalink">
										<a href={podcast.url} target="_blank" rel="noopener">
											Listen &rarr;
										</a>
									</p>
								</div>
							</article>
						);
					})
				}
			</div>
		</section>
	</div>
</PageLayout>

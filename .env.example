# === Notion CMS ===
NOTION_API_SECRET=
# Optional overrides. Prefer DATA_SOURCE_ID when you have it; DATABASE_ID works as a fallback.
DATA_SOURCE_ID=
DATABASE_ID=

# === Enrichment (optional) ===
# Used to capture product screenshots / brand data during content work.
CONTEXT_DEV_API_KEY=

# === Cloudflare deploy (GitHub Actions secrets) ===
# Wrangler also reads these locally when you run `npm run deploy`.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# === Cloudflare R2 (optional, for media/asset storage) ===
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
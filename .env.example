# === Notion CMS ===
NOTION_API_SECRET=
# Optional overrides. Prefer DATA_SOURCE_ID when you have it; DATABASE_ID works as a fallback.
DATA_SOURCE_ID=
DATABASE_ID=

# === Context.dev (server-side only) ===
# Scrape URLs into Markdown. Never expose to the browser or commit a real key.
# Local: put it in .env.local. Deploy: `wrangler secret put CONTEXT_DEV_API_KEY`.
CONTEXT_DEV_API_KEY=

# Optional server-side proxy at /api/context/* (see src/worker.js).
# Off unless ENABLE_CONTEXT_API is exactly "true". Set CONTEXT_API_TOKEN to
# require `Authorization: Bearer <token>` on every request.
ENABLE_CONTEXT_API=
CONTEXT_API_TOKEN=

# === Cloudflare deploy (GitHub Actions secrets) ===
# Wrangler also reads these locally when you run `npm run deploy`.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# === Cloudflare R2 (optional, for media/asset storage) ===
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
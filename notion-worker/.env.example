# Personal access token used by syncs, webhooks, and local `ntn workers exec`.
# Tools invoked by a Notion Custom Agent are pre-authenticated and ignore this.
NOTION_API_TOKEN=

# Focus Lab CMS data source. Defaults to the live Focus Lab CMS.
FOCUSLAB_DATA_SOURCE_ID=
FOCUSLAB_SITE_URL=https://focuslab.pk

# Rebuild trigger. Set DEPLOY_HOOK_URL, or the GitHub dispatch variables.
DEPLOY_HOOK_URL=
GITHUB_DEPLOY_TOKEN=
GITHUB_DEPLOY_REPO=owner/repo
GITHUB_DEPLOY_WORKFLOW=deploy-cloudflare.yml
GITHUB_DEPLOY_REF=main
# When "true", publishing content also triggers a rebuild.
AUTO_DEPLOY_ON_PUBLISH=false

# Optional shared secret checked by the onDeployRequest webhook.
WEBHOOK_SHARED_SECRET=